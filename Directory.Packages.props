<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <ShinyVersion>5.6.3</ShinyVersion>
        <MauiLabsVersion>0.1.0-preview.12.26421.1</MauiLabsVersion>
        <ControlsVersion>1.4.0-beta-0011</ControlsVersion>
        <MauiVersion>10.0.101</MauiVersion>
        <!-- Shiny.Extensions.* travel together: MauiHosting depends on DependencyInjection at its
             own exact version, so a lower pin on the direct reference is an NU1605 downgrade. -->
        <ShinyExtensionsVersion>5.2.1</ShinyExtensionsVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12"/>
        <PackageVersion Include="Shiny.Hosting.Maui" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Notifications" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Notifications.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Jobs" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Core.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="13.5.0"/>
        <PackageVersion Include="Shiny.Extensions.Stores" Version="$(ShinyExtensionsVersion)"/>
        <PackageVersion Include="Shiny.Extensions.DependencyInjection" Version="$(ShinyExtensionsVersion)"/>
        <!-- IStartupService (launch at login) for the desktop heads. Ships a net10.0-macos asset,
             so the labs AppKit head is covered; the GTK head takes the plain net10.0 one, which
             carries the XDG autostart implementation. -->
        <PackageVersion Include="Shiny.Extensions.MauiHosting" Version="$(ShinyExtensionsVersion)"/>
        <PackageVersion Include="Shiny.Maui.Controls.Desktop" Version="$(ControlsVersion)"/>
        <PackageVersion Include="Shiny.Blazor.Controls" Version="$(ControlsVersion)"/>
        <PackageVersion Include="Shiny.Mediator.Maui" Version="6.8.0"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.BlazorWebView" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.BlazorWebView" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Octokit" Version="14.0.0"/>
        <!-- git, in-process. The natives for the desktop RIDs come from LibGit2Sharp.NativeBinaries,
             which the package pulls in itself; iOS and Android have no published natives and are fed
             hand-built ones (see eng/libgit2/). Bumping this changes the DllImport name the mobile
             binaries have to match — check eng/libgit2/README.md before you do. -->
        <PackageVersion Include="LibGit2Sharp" Version="0.32.0"/>
        <!-- Referenced explicitly only so the mobile heads can exclude it — see GitHubShine.csproj.
             The version is pinned by LibGit2Sharp itself ([2.0.324]) and must match it exactly. -->
        <PackageVersion Include="LibGit2Sharp.NativeBinaries" Version="2.0.324"/>
        <!-- MAUI DevFlow ships in lockstep with the labs platform packages, so it rides the same
             version property. The .Gtk pair is the Linux/GTK4 flavour of the same two libraries. -->
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Blazor" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent.Gtk" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Blazor.Gtk" Version="$(MauiLabsVersion)"/>
    </ItemGroup>
</Project>