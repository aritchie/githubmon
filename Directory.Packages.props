<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.9"/>
        <PackageVersion Include="Shiny.Mediator" Version="6.6.2"/>
        <PackageVersion Include="Shiny.Mediator.Maui" Version="6.6.2"/>
        <PackageVersion Include="Shiny.Notifications" Version="5.1.1"/>
        <PackageVersion Include="Shiny.Notifications.Linux" Version="5.1.1"/>
        <PackageVersion Include="Shiny.Blazor.Controls" Version="1.0.1-beta-0142"/>
        <PackageVersion Include="Shiny.Maui.Controls.Desktop" Version="1.0.1-beta-0142"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="10.0.2"/>
        <PackageVersion Include="Shiny.DocumentDb.Extensions.DependencyInjection" Version="10.0.2"/>
        <PackageVersion Include="Shiny.Extensions.Stores" Version="5.1.2"/>
        <PackageVersion Include="Shiny.Extensions.DependencyInjection" Version="5.1.2"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.11.26317.2"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.11.26317.2"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.BlazorWebView" Version="0.1.0-preview.11.26317.2"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="0.1.0-preview.11.26317.2"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-preview.11.26317.2"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.BlazorWebView" Version="0.1.0-preview.11.26317.2"/>
        <PackageVersion Include="Octokit" Version="14.0.0"/>
    </ItemGroup>
</Project>