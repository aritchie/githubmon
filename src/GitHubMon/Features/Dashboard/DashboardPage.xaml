<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:dash="clr-namespace:GitHubMon.Dashboard"
             x:Class="GitHubMon.Dashboard.DashboardPage"
             x:DataType="dash:DashboardViewModel"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,*">

        <!-- Header bar -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource BgSubtleLight}, Dark={StaticResource BgSubtleDark}}">
            <Border.StrokeShape>
                <Rectangle />
            </Border.StrokeShape>
            <Grid Padding="24,18" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="16">
                <Label Grid.Column="0" Style="{StaticResource DisplayLabel}" Text="GitHubMon" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Style="{StaticResource MutedLabel}"
                       Text="{Binding StatusText}"
                       VerticalOptions="Center"
                       IsVisible="{Binding StatusText, Converter={StaticResource StringToBoolConverter}}" />

                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Label Style="{StaticResource MutedLabel}" Text="Mute" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding NotificationsMuted, Mode=TwoWay}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Grid.Column="3"
                        Style="{StaticResource GhostButton}"
                        Text="Manage accounts"
                        Command="{Binding ManageAccountsCommand}" />

                <Button Grid.Column="4"
                        Style="{StaticResource GhostButton}"
                        Text="Refresh"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                <Button Grid.Column="5"
                        Style="{StaticResource PrimaryButton}"
                        Text="+ Add account"
                        Command="{Binding AddAccountCommand}" />
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">

                <!-- Empty state -->
                <Border Style="{StaticResource Card}"
                        Padding="32"
                        IsVisible="{Binding IsEmpty}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Style="{StaticResource TitleLabel}"
                               Text="No accounts connected yet"
                               HorizontalTextAlignment="Center" />
                        <Label Style="{StaticResource MutedLabel}"
                               Text="Add a GitHub account with a fine-grained personal access token to start monitoring your repos."
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="480" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Text="+ Add your first GitHub account"
                                Command="{Binding AddAccountCommand}"
                                HorizontalOptions="Center"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Inbox -->
                <Border Style="{StaticResource Card}"
                        IsVisible="{Binding Inbox.Count, Converter={StaticResource CountToBoolConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Needs your attention" />
                            <Label Grid.Column="1" Style="{StaticResource MutedLabel}" Text="{Binding Inbox.Count, StringFormat='{}{0} items'}" />
                        </Grid>
                        <CollectionView ItemsSource="{Binding Inbox}" HeightRequest="220">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dash:InboxItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,6" ColumnSpacing="12">
                                        <shiny:PillView Grid.Column="0" Text="{Binding Reason}" Type="Info" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Style="{StaticResource BodyLabel}" Text="{Binding Title}" LineBreakMode="TailTruncation" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding RepoFullName}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Style="{StaticResource MutedLabel}" Text="{Binding UpdatedAt, StringFormat='{0:t}'}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Repos -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Style="{StaticResource SectionLabel}" Text="Repositories" />
                    <CollectionView ItemsSource="{Binding Cards}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dash:RepoCardViewModel">
                                <Border Style="{StaticResource Card}" MinimumHeightRequest="160">
                                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                        <VerticalStackLayout Grid.Row="0" Spacing="2">
                                            <Label Style="{StaticResource TitleLabel}" Text="{Binding Title}" FontSize="15" LineBreakMode="TailTruncation" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding AccountLabel}" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Row="1" Spacing="6">
                                            <shiny:PillView Text="{Binding OpenIssues, StringFormat='{}Issues {0}'}" Type="Info" />
                                            <shiny:PillView Text="{Binding OpenPullRequests, StringFormat='{}PRs {0}'}" Type="Info" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Row="2" Spacing="6"
                                                               IsVisible="{Binding LatestRunStatus, Converter={StaticResource StringToBoolConverter}}">
                                            <shiny:PillView Text="{Binding LatestRunStatus}" Type="{Binding LatestRunPillType}" />
                                            <Label Style="{StaticResource MutedLabel}" Text="{Binding LatestRunDescription}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>

                                        <Label Grid.Row="3"
                                               Style="{StaticResource DangerLabel}"
                                               Text="{Binding ErrorMessage}"
                                               IsVisible="{Binding HasError}"
                                               VerticalOptions="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
