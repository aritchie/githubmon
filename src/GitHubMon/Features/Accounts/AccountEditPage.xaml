<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:acct="clr-namespace:GitHubMon.Accounts"
             x:Class="GitHubMon.Accounts.AccountEditPage"
             x:DataType="acct:AccountEditViewModel"
             Title="Edit account">

    <!-- Outer Grid (no page ScrollView). Repos card row is Star so its internal
         CollectionView fills the remaining space and is the only scrollable area.
         Actions row stays pinned at the bottom and is always reachable. -->
    <Grid Padding="32"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="20"
          MaximumWidthRequest="760"
          HorizontalOptions="Center">

        <!-- Title -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Style="{StaticResource DisplayLabel}" Text="GitHub account" />
            <Label Style="{StaticResource MutedLabel}"
                   Text="Connect a GitHub account by giving it a label and a fine-grained personal access token." />
        </VerticalStackLayout>

        <!-- Identity card -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="14">
                <Label Style="{StaticResource SectionLabel}" Text="Identity" />

                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource BodyLabel}" Text="Label" />
                    <Entry Style="{StaticResource FormEntry}"
                           Text="{Binding Label, Mode=TwoWay}"
                           Placeholder="e.g. Personal, Work, OSS org" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource BodyLabel}" Text="Fine-grained personal access token" />
                        <Label Grid.Column="1" Style="{StaticResource MutedLabel}" Text="github.com/settings/personal-access-tokens" VerticalOptions="Center" />
                    </Grid>
                    <Entry Style="{StaticResource FormEntry}"
                           Text="{Binding Token, Mode=TwoWay}"
                           IsPassword="True"
                           Placeholder="github_pat_..." />
                    <HorizontalStackLayout Spacing="10">
                        <Button Style="{StaticResource GhostButton}"
                                Text="Validate &amp; list repos"
                                Command="{Binding ValidateCommand}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Repos card — fills remaining space; CollectionView inside is the only scroll surface -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Style="{StaticResource SectionLabel}" Text="Repositories to monitor" />
                        <Label Style="{StaticResource MutedLabel}" Text="{Binding SelectionSummary}" IsVisible="{Binding HasFetchedRepos}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" IsVisible="{Binding HasFetchedRepos}">
                        <Button Style="{StaticResource GhostButton}" Text="Select all" Command="{Binding SelectAllVisibleCommand}" />
                        <Button Style="{StaticResource GhostButton}" Text="Clear" Command="{Binding ClearSelectionCommand}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Filter (only after fetch) -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasFetchedRepos}">
                    <Entry Grid.Column="0"
                           Style="{StaticResource FormEntry}"
                           Text="{Binding FilterText, Mode=TwoWay}"
                           Placeholder="Filter repos by name or description…" />
                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsLoadingRepos}"
                                       IsVisible="{Binding IsLoadingRepos}"
                                       VerticalOptions="Center" />
                </Grid>

                <!-- Body: either "enter a token" hint or the repo list -->
                <Grid Grid.Row="2">
                    <Border Style="{StaticResource SubtleCard}"
                            Padding="16"
                            VerticalOptions="Start"
                            IsVisible="{Binding HasFetchedRepos, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Style="{StaticResource MutedLabel}"
                               HorizontalTextAlignment="Center"
                               Text="Enter a personal access token above and click Validate to load the repositories this token can access." />
                    </Border>

                    <CollectionView ItemsSource="{Binding FilteredRepos}"
                                    IsVisible="{Binding HasFetchedRepos}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource MutedLabel}"
                                   HorizontalTextAlignment="Center"
                                   Text="No repos match the filter." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="acct:RepoSelection">
                                <Grid ColumnDefinitions="Auto,*" Padding="8,8" ColumnSpacing="12">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource BodyLabel}"
                                           Text="{Binding FullName}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
        </Border>

        <!-- Actions: always visible at the bottom -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <Label Grid.Column="0"
                   Style="{StaticResource MutedLabel}"
                   Text="{Binding ValidationMessage}"
                   VerticalOptions="Center"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding ValidationMessage, Converter={StaticResource StringToBoolConverter}}" />
            <ActivityIndicator Grid.Column="1"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center" />
            <Button Grid.Column="2"
                    Style="{StaticResource GhostButton}"
                    Text="Cancel"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButton}"
                    Text="Save account"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</ContentPage>
