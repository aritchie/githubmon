<?xml version="1.0" encoding="UTF-8" ?>
<shiny:ShinyShell
    x:Class="GitHubMon.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
    xmlns:dash="clr-namespace:GitHubMon.Dashboard"
    xmlns:acct="clr-namespace:GitHubMon.Accounts"
    FlyoutBehavior="Disabled"
    Title="GitHubMon">

    <TabBar>
        <ShellContent Title="Dashboard"
                      Route="Dashboard"
                      ContentTemplate="{DataTemplate dash:DashboardPage}" />
        <ShellContent Title="Accounts"
                      Route="Accounts"
                      ContentTemplate="{DataTemplate acct:AccountsPage}" />
    </TabBar>

</shiny:ShinyShell>
