<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- GitHub-inspired palette (primer.style/primitives). Light + Dark pairs. -->

    <!-- Accent (links, primary buttons, focus rings) -->
    <Color x:Key="AccentLight">#0969DA</Color>
    <Color x:Key="AccentDark">#2F81F7</Color>

    <Color x:Key="AccentSubtleLight">#DDF4FF</Color>
    <Color x:Key="AccentSubtleDark">#0C2D6B</Color>

    <!-- Status -->
    <Color x:Key="SuccessLight">#1A7F37</Color>
    <Color x:Key="SuccessDark">#3FB950</Color>

    <Color x:Key="AttentionLight">#9A6700</Color>
    <Color x:Key="AttentionDark">#D29922</Color>

    <Color x:Key="DangerLight">#CF222E</Color>
    <Color x:Key="DangerDark">#F85149</Color>

    <Color x:Key="DoneLight">#8250DF</Color>
    <Color x:Key="DoneDark">#A371F7</Color>

    <!-- Surfaces -->
    <Color x:Key="BgCanvasLight">#FFFFFF</Color>
    <Color x:Key="BgCanvasDark">#0D1117</Color>

    <Color x:Key="BgSubtleLight">#F6F8FA</Color>
    <Color x:Key="BgSubtleDark">#161B22</Color>

    <Color x:Key="BgMutedLight">#EAEEF2</Color>
    <Color x:Key="BgMutedDark">#21262D</Color>

    <!-- Borders -->
    <Color x:Key="BorderDefaultLight">#D0D7DE</Color>
    <Color x:Key="BorderDefaultDark">#30363D</Color>

    <Color x:Key="BorderMutedLight">#E4E7EB</Color>
    <Color x:Key="BorderMutedDark">#21262D</Color>

    <!-- Text -->
    <Color x:Key="FgDefaultLight">#1F2328</Color>
    <Color x:Key="FgDefaultDark">#E6EDF3</Color>

    <Color x:Key="FgMutedLight">#656D76</Color>
    <Color x:Key="FgMutedDark">#7D8590</Color>

    <Color x:Key="FgSubtleLight">#8D96A0</Color>
    <Color x:Key="FgSubtleDark">#6E7681</Color>

    <Color x:Key="FgOnAccent">#FFFFFF</Color>

    <!-- Legacy MAUI keys still referenced by template-generated styles. Keep them mapped
         to the GitHub palette so the rest of the default Styles.xaml stays coherent. -->
    <Color x:Key="Primary">#0969DA</Color>
    <Color x:Key="PrimaryDark">#2F81F7</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#DDF4FF</Color>
    <Color x:Key="SecondaryDarkText">#A371F7</Color>
    <Color x:Key="Tertiary">#1A7F37</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0D1117</Color>
    <Color x:Key="OffBlack">#0D1117</Color>

    <Color x:Key="Gray100">#F6F8FA</Color>
    <Color x:Key="Gray200">#D0D7DE</Color>
    <Color x:Key="Gray300">#AFB8C1</Color>
    <Color x:Key="Gray400">#8C959F</Color>
    <Color x:Key="Gray500">#6E7681</Color>
    <Color x:Key="Gray600">#484F58</Color>
    <Color x:Key="Gray900">#21262D</Color>
    <Color x:Key="Gray950">#0D1117</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
