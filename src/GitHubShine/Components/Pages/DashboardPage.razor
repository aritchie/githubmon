@page "/"
@* The Repositories page merged into this one — its route survives as a deep link that opens
   the grid view directly, and as what the nav's old entry pointed at. *@
@page "/repos"
@implements IDisposable
@inject IMediator Mediator
@inject IConfigStore Config
@inject SnapshotCache Cache
@inject NavigationManager Nav
@inject IBrowser Browser

<div class="page">
    <div class="page-header">
        <h1>Dashboard</h1>
        @if (statusText is not null)
        {
            <span class="subtitle">@statusText</span>
        }
        <span class="spacer"></span>
        <button class="btn" @onclick="RefreshAsync" disabled="@isBusy">
            @if (isBusy)
            {
                <span class="spinner"></span>
            }
            Refresh
        </button>
        <button class="btn primary" @onclick="@(() => Nav.NavigateTo("/accounts/edit"))">+ Add account</button>
    </div>

    @if (cards.Count == 0)
    {
        <div class="card empty-state">
            <h2>No accounts connected yet</h2>
            <p>Add a GitHub account with a fine-grained personal access token to start monitoring your repos.</p>
            <button class="btn primary" @onclick="@(() => Nav.NavigateTo("/accounts/edit"))">+ Add your first GitHub account</button>
        </div>
    }
    else
    {
        @if (inbox.Count > 0)
        {
            <div class="card" style="margin-bottom: 20px;">
                <div class="page-header" style="margin-bottom: 10px;">
                    <h2>Needs your attention</h2>
                    <span class="spacer"></span>
                    <span class="muted">@inbox.Count item@(inbox.Count == 1 ? "" : "s")</span>
                </div>
                <div class="inbox-list">
                    @foreach (var item in inbox)
                    {
                        <div class="inbox-row">
                            <Pill Text="@item.Reason.ToString()" Type="PillType.Info" />
                            <div class="inbox-body">
                                <div class="inbox-title">@item.Title</div>
                                <div class="inbox-repo">@item.RepoFullName</div>
                            </div>
                            <time>@item.UpdatedAt.LocalDateTime.ToString("t")</time>
                        </div>
                    }
                </div>
            </div>
        }

        @* One heading for both views — the switch changes how the same repos are drawn, so it
           belongs next to the list rather than up in the page header with Refresh. *@
        <div class="section-title-row">
            <div class="section-title">
                Repositories
                <span class="muted" style="text-transform:none;font-weight:400;">— @ViewHint</span>
            </div>
            <span class="spacer"></span>
            <div class="view-switch" role="group" aria-label="Repository view">
                <button class="view-switch-btn @(view == RepoViewMode.Cards ? "active" : "")"
                        @onclick="() => SetViewAsync(RepoViewMode.Cards)"
                        title="Cards you can drag into the order you want">Cards</button>
                <button class="view-switch-btn @(view == RepoViewMode.Table ? "active" : "")"
                        @onclick="() => SetViewAsync(RepoViewMode.Table)"
                        title="One row per repo, sortable by any column">Table</button>
            </div>
        </div>
        <div class="repo-pick-toolbar">
            <input type="search" value="@searchText" @oninput="OnSearchChanged"
                   placeholder="Filter repos by name…" />
            @if (searchText.Length > 0)
            {
                <span class="muted">@visibleCards.Count of @cards.Count</span>
            }
        </div>
        <div class="card totals-bar">
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.Stars)</span>
                <span class="total-label">★ Stars</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.Forks)</span>
                <span class="total-label">⑂ Forks</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.Watchers)</span>
                <span class="total-label">👁 Watchers</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.OpenIssues)</span>
                <span class="total-label">Open issues</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.OpenPullRequests)</span>
                <span class="total-label">Open PRs</span>
            </div>
            <div class="total">
                <span class="total-value ok">@cards.Count(c => c.LatestRunSucceeded)</span>
                <span class="total-label">Builds passing</span>
            </div>
            <div class="total">
                <span class="total-value bad">@cards.Count(c => c.LatestRunFailed)</span>
                <span class="total-label">Builds failing</span>
            </div>
        </div>

        @if (visibleCards.Count == 0)
        {
            <div class="card empty-state">
                <p>No repos match “@searchText”.</p>
            </div>
        }
        else if (view == RepoViewMode.Table)
        {
            <div class="card repo-table">
                @* Re-keyed whenever the row set changes — the monitored repos, or the search
                   filter: ServerData is only re-invoked by the grid itself (on a header click)
                   or on its first render, so recreating the component is the only way to push a
                   different set of rows into it. *@
                <DataGrid TItem="RepoCardModel"
                          @key="gridKey"
                          ServerData="LoadAsync"
                          SortMode="DataGridSortMode.Single"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          Bordered="true"
                          NoRecordsText="No repositories are being monitored.">
                    <Columns>
                        @* Filtering is switched off on every column: the toolbar's search box
                           filters this view, and with ServerData in play the grid would only hand
                           its own filters back for the app to apply anyway. *@
                        <PropertyColumn Property="c => c.Title" Title="Repository" Filterable="false">
                            <CellTemplate>
                                <span class="grid-link" title="Open repository"
                                      @onclick="() => OpenAsync(context.Item.RepoUrl)">@context.Item.Title</span>
                                @if (context.Item.HasError)
                                {
                                    <span title="@context.Item.ErrorMessage">
                                        <Pill Text="Error" Type="PillType.Critical" />
                                    </span>
                                }
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn Property="c => c.AccountLabel" Title="Account" Filterable="false" />

                        @* Bound to the rank rather than a bool so sorting reads as private-first
                           and repos with no snapshot yet sort last instead of with the public ones. *@
                        <PropertyColumn Property="c => c.VisibilityRank" Title="Visibility" Filterable="false">
                            <CellTemplate>
                                <VisibilityPill IsPrivate="context.Item.IsPrivate" />
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn Property="c => c.Stars" Title="Stars" Filterable="false">
                            <CellTemplate>
                                <span class="grid-link grid-num" title="Open stargazers"
                                      @onclick="() => OpenAsync(context.Item.StarsUrl)">★ @context.Item.Stars</span>
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn Property="c => c.Forks" Title="Forks" Filterable="false">
                            <CellTemplate>
                                <span class="grid-link grid-num" title="Open forks"
                                      @onclick="() => OpenAsync(context.Item.ForksUrl)">⑂ @context.Item.Forks</span>
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn Property="c => c.Watchers" Title="Watchers" Filterable="false">
                            <CellTemplate>
                                <span class="grid-link grid-num" title="Open watchers"
                                      @onclick="() => OpenAsync(context.Item.WatchersUrl)">👁 @context.Item.Watchers</span>
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn Property="c => c.OpenIssues" Title="Open issues" Filterable="false">
                            <CellTemplate>
                                <span class="grid-link grid-num" title="Open issues"
                                      @onclick="() => OpenAsync(context.Item.IssuesUrl)">@context.Item.OpenIssues</span>
                            </CellTemplate>
                        </PropertyColumn>

                        <PropertyColumn Property="c => c.OpenPullRequests" Title="Open PRs" Filterable="false">
                            <CellTemplate>
                                <span class="grid-link grid-num" title="Open pull requests"
                                      @onclick="() => OpenAsync(context.Item.PullsUrl)">@context.Item.OpenPullRequests</span>
                            </CellTemplate>
                        </PropertyColumn>

                        @* Bound to the numeric rank, not the status text, so sorting puts failures
                           first instead of ordering them alphabetically. *@
                        <PropertyColumn Property="c => c.BuildRank" Title="Build" Filterable="false">
                            <CellTemplate>
                                <span class="grid-link" title="@context.Item.LatestRunDescription"
                                      @onclick="() => OpenAsync(context.Item.LatestRunUrl ?? context.Item.ActionsUrl)">
                                    <Pill Text="@(context.Item.LatestRunStatus ?? "No runs")"
                                          Type="context.Item.LatestRunPillType" />
                                </span>
                            </CellTemplate>
                        </PropertyColumn>
                    </Columns>
                </DataGrid>
            </div>
        }
        else
        {
            <div class="repo-grid">
                @foreach (var card in visibleCards)
                {
                    <div class="card repo-card @(dragKey == card.Key ? "dragging" : "")"
                         @key="card.Key"
                         draggable="true"
                         @ondragstart="() => dragKey = card.Key"
                         @ondragend="() => dragKey = null"
                         @ondragenter:preventDefault
                         @ondragover:preventDefault
                         @ondrop="() => OnDropOnAsync(card)">
                        <div class="repo-card-head">
                            <div style="min-width:0;">
                                <div class="repo-name repo-link" title="Open repository on GitHub"
                                     @onclick="() => OpenAsync(card.RepoUrl)">@card.Title</div>
                                <div class="account-label">@card.AccountLabel</div>
                            </div>
                            <span class="move-buttons">
                                <button class="move-btn" title="Move earlier" disabled="@(cards.IndexOf(card) == 0)"
                                        @onclick="() => MoveCardAsync(card, -1)">‹</button>
                                <button class="move-btn" title="Move later" disabled="@(cards.IndexOf(card) == cards.Count - 1)"
                                        @onclick="() => MoveCardAsync(card, +1)">›</button>
                            </span>
                        </div>
                        <div class="pills">
                            <VisibilityPill IsPrivate="card.IsPrivate" />
                            <span class="pill-link" title="Open issues on GitHub"
                                  @onclick="() => OpenAsync(card.IssuesUrl)">
                                <Pill Text="@($"Issues {card.OpenIssues}")" Type="PillType.Info" />
                            </span>
                            <span class="pill-link" title="Open pull requests on GitHub"
                                  @onclick="() => OpenAsync(card.PullsUrl)">
                                <Pill Text="@($"PRs {card.OpenPullRequests}")" Type="PillType.Info" />
                            </span>
                        </div>
                        <div class="pills repo-stats">
                            <span class="stat stat-link" title="Open stargazers on GitHub"
                                  @onclick="() => OpenAsync(card.StarsUrl)">★ @card.Stars</span>
                            <span class="stat stat-link" title="Open forks on GitHub"
                                  @onclick="() => OpenAsync(card.ForksUrl)">⑂ @card.Forks</span>
                            <span class="stat stat-link" title="Open watchers on GitHub"
                                  @onclick="() => OpenAsync(card.WatchersUrl)">👁 @card.Watchers</span>
                        </div>
                        @if (card.LatestRunStatus is not null)
                        {
                            <div class="pills">
                                <span class="pill-link" title="Open this workflow run on GitHub"
                                      @onclick="() => OpenAsync(card.LatestRunUrl ?? card.ActionsUrl)">
                                    <Pill Text="@card.LatestRunStatus" Type="card.LatestRunPillType" />
                                    <span class="run-desc">@card.LatestRunDescription</span>
                                </span>
                            </div>
                        }
                        @if (card.HasError)
                        {
                            <div class="error">@card.ErrorMessage</div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    readonly List<RepoCardModel> cards = new();
    readonly List<InboxItem> inbox = new();
    readonly List<IDisposable> subs = new();

    bool isBusy;
    string? statusText;
    string? dragKey;
    string searchText = "";
    List<string> savedOrder = new();

    RepoViewMode view = RepoViewMode.Cards;
    RepoGridSort sort = RepoGridSort.Default;

    // Bumped whenever the grid's row set changes; the search text rides along because filtering
    // happens here, not in the grid. Both go into the DataGrid's @key — see the comment there.
    int gridEpoch;
    string gridKey => $"{gridEpoch}|{searchText}";

    // False until the grid has asked for data once. The first ask carries an empty sort list
    // (the grid starts unsorted), which must NOT be read as "the user cleared the sort" — that
    // would overwrite the sort just restored from storage. Reset with every re-key.
    bool gridLoaded;

    string ViewHint => view == RepoViewMode.Table
        ? $"click a column header to sort · sorted by {RepoGridColumns.Label(sort.ColumnId)} {(sort.Descending ? "↓" : "↑")}"
        : "drag cards (or use ‹ ›) to reorder";

    // The cards visible after applying the search filter. A blank search shows everything.
    IReadOnlyList<RepoCardModel> visibleCards =>
        searchText.Length == 0
            ? cards
            : cards
                .Where(c => c.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                         || c.AccountLabel.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        // The grid holds the rows it was handed; a changed filter is a changed row set.
        InvalidateGrid();
    }

    /// <summary>Forces the grid to re-fetch (and re-sort) the next time it renders.</summary>
    void InvalidateGrid()
    {
        gridEpoch++;
        gridLoaded = false;
    }

    async Task SetViewAsync(RepoViewMode next)
    {
        if (view == next)
            return;

        view = next;
        // Switching away disposes the grid, so the one that comes back is a new instance with
        // no sort state of its own — it must be treated as a first load, not a cleared sort.
        InvalidateGrid();
        await Config.SetRepoViewAsync(next);
    }

    /// <summary>
    /// The grid's data source. It is also the only hook the grid exposes onto its sort state, so
    /// persisting here IS the "remember my sort" feature: the grid calls this on first render and
    /// again after every header click.
    /// </summary>
    async Task<GridData<RepoCardModel>> LoadAsync(GridState state)
    {
        if (gridLoaded)
        {
            // A real header click. An empty list means the column was cycled past descending back
            // to unsorted — fall back to the default rather than leaving the rows in whatever
            // arbitrary order they happened to be in.
            var def = state.SortDefinitions.FirstOrDefault();
            var next = def is null
                ? RepoGridSort.Default
                : new RepoGridSort(def.ColumnId, def.Direction == DataGridSortDirection.Descending);

            if (next != sort)
            {
                sort = next;
                await Config.SetRepoGridSortAsync(sort);
                // The grid re-renders itself after this returns, but the page does not — without
                // this the heading keeps describing the previous sort.
                StateHasChanged();
            }
        }
        gridLoaded = true;

        var ordered = sort.Order(visibleCards);
        return new GridData<RepoCardModel>(ordered, ordered.Count);
    }

    Task OpenAsync(string url) => Browser.OpenAsync(url, BrowserLaunchMode.External);

    protected override async Task OnInitializedAsync()
    {
        subs.Add(Mediator.Subscribe<SnapshotUpdatedEvent>(OnSnapshotUpdated));
        subs.Add(Mediator.Subscribe<InboxUpdatedEvent>(OnInboxUpdated));
        Config.Changed += OnConfigChanged;

        savedOrder = (await Config.GetRepoOrderAsync()).ToList();
        sort = await Config.GetRepoGridSortAsync();

        // /repos was the old Repositories page: arriving by that route asks for the grid this
        // once. Not persisted — a deep link shouldn't quietly rewrite the saved preference.
        view = IsGridRoute ? RepoViewMode.Table : await Config.GetRepoViewAsync();
        await Config.ReloadAsync();
        RebuildCards();
    }

    /// <summary>True on the /repos alias, which asks for the grid whatever the preference says.</summary>
    bool IsGridRoute => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/') == "repos";

    // "/" and "/repos" are the same component, so Blazor reuses this instance when navigating
    // between them and OnInitializedAsync doesn't run again — the alias has to be honoured here
    // as well or it only works when arriving from some other page.
    protected override void OnParametersSet()
    {
        if (IsGridRoute && view != RepoViewMode.Table)
        {
            view = RepoViewMode.Table;
            InvalidateGrid();
        }
    }

    void RebuildCards()
    {
        var existing = cards.ToDictionary(c => c.Key);
        var before = cards.Select(c => c.Key).ToList();
        cards.Clear();

        var desired = Config.Accounts
            .SelectMany(a => a.Repos.Select(r => (Account: a, Repo: r)))
            .OrderBy(d =>
            {
                var i = savedOrder.IndexOf($"{d.Account.Id}|{d.Repo.FullName}");
                return i < 0 ? int.MaxValue : i;
            })
            .ToList();

        foreach (var (account, repo) in desired)
        {
            var key = $"{account.Id}|{repo.FullName}";
            if (!existing.TryGetValue(key, out var card))
            {
                card = new RepoCardModel(account, repo);
                var snap = Cache.TryGet(account.Id, repo);
                if (snap is not null)
                    card.Apply(snap);
            }
            cards.Add(card);
        }

        statusText = cards.Count == 0
            ? null
            : $"{cards.Count} repo{(cards.Count == 1 ? "" : "s")} monitored";

        // Only a changed row set needs the grid rebuilt — value updates reach it through the card
        // instances it already holds, so a poll doesn't yank rows out from under the pointer.
        if (!before.SequenceEqual(cards.Select(c => c.Key)))
            InvalidateGrid();
    }

    async Task OnDropOnAsync(RepoCardModel target)
    {
        if (dragKey is null || dragKey == target.Key)
            return;
        var dragged = cards.FirstOrDefault(c => c.Key == dragKey);
        dragKey = null;
        if (dragged is null)
            return;

        var from = cards.IndexOf(dragged);
        var to = cards.IndexOf(target);
        cards.RemoveAt(from);
        cards.Insert(to, dragged);
        await PersistOrderAsync();
    }

    async Task MoveCardAsync(RepoCardModel card, int delta)
    {
        var from = cards.IndexOf(card);
        var to = from + delta;
        if (from < 0 || to < 0 || to >= cards.Count)
            return;
        cards.RemoveAt(from);
        cards.Insert(to, card);
        await PersistOrderAsync();
    }

    Task PersistOrderAsync()
    {
        savedOrder = cards.Select(c => c.Key).ToList();
        return Config.SetRepoOrderAsync(savedOrder);
    }

    void OnConfigChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(() =>
        {
            RebuildCards();
            StateHasChanged();
        });

    Task OnSnapshotUpdated(SnapshotUpdatedEvent e, IMediatorContext _, CancellationToken __)
        => InvokeAsync(() =>
        {
            var key = $"{e.AccountId}|{e.Repo.FullName}";
            var card = cards.FirstOrDefault(c => c.Key == key);
            if (card is null)
                return;
            // Every poll re-snapshots every repo even when nothing moved; only
            // re-render when a displayed value actually changed, so an idle app
            // isn't pushing identical render batches into the WebView each minute.
            if (card.Apply(e.Snapshot))
                StateHasChanged();
        });

    Task OnInboxUpdated(InboxUpdatedEvent e, IMediatorContext _, CancellationToken __)
        => InvokeAsync(() =>
        {
            var merged = inbox
                .Where(i => i.AccountId != e.AccountId)
                .Concat(e.Items)
                .Where(i => i.Reason is InboxReason.Mention or InboxReason.Assigned or InboxReason.ReviewRequested)
                .OrderByDescending(i => i.UpdatedAt)
                .ToList();
            // InboxItem is a record, so SequenceEqual is a value comparison — skip
            // the re-render (and its WebView render batch) when the list is identical.
            if (merged.SequenceEqual(inbox))
                return;
            inbox.Clear();
            inbox.AddRange(merged);
            StateHasChanged();
        });

    async Task RefreshAsync()
    {
        if (isBusy)
            return;
        isBusy = true;
        try
        {
            await Mediator.Send(new RefreshAllCommand(true));
        }
        finally
        {
            isBusy = false;
        }
    }

    public void Dispose()
    {
        Config.Changed -= OnConfigChanged;
        foreach (var s in subs)
            s.Dispose();
    }
}
