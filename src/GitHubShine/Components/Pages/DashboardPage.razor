@page "/"
@implements IDisposable
@inject IMediator Mediator
@inject IConfigStore Config
@inject SnapshotCache Cache
@inject NavigationManager Nav
@inject IBrowser Browser

<div class="page">
    <div class="page-header">
        <h1>Dashboard</h1>
        @if (statusText is not null)
        {
            <span class="subtitle">@statusText</span>
        }
        <span class="spacer"></span>
        <button class="btn" @onclick="RefreshAsync" disabled="@isBusy">
            @if (isBusy)
            {
                <span class="spinner"></span>
            }
            Refresh
        </button>
        <button class="btn primary" @onclick="@(() => Nav.NavigateTo("/accounts/edit"))">+ Add account</button>
    </div>

    @if (cards.Count == 0)
    {
        <div class="card empty-state">
            <h2>No accounts connected yet</h2>
            <p>Add a GitHub account with a fine-grained personal access token to start monitoring your repos.</p>
            <button class="btn primary" @onclick="@(() => Nav.NavigateTo("/accounts/edit"))">+ Add your first GitHub account</button>
        </div>
    }
    else
    {
        @if (inbox.Count > 0)
        {
            <div class="card" style="margin-bottom: 20px;">
                <div class="page-header" style="margin-bottom: 10px;">
                    <h2>Needs your attention</h2>
                    <span class="spacer"></span>
                    <span class="muted">@inbox.Count item@(inbox.Count == 1 ? "" : "s")</span>
                </div>
                <div class="inbox-list">
                    @foreach (var item in inbox)
                    {
                        <div class="inbox-row">
                            <Pill Text="@item.Reason.ToString()" Type="PillType.Info" />
                            <div class="inbox-body">
                                <div class="inbox-title">@item.Title</div>
                                <div class="inbox-repo">@item.RepoFullName</div>
                            </div>
                            <time>@item.UpdatedAt.LocalDateTime.ToString("t")</time>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="section-title">Repositories <span class="muted" style="text-transform:none;font-weight:400;">— drag cards (or use ‹ ›) to reorder</span></div>
        <div class="repo-pick-toolbar">
            <input type="search" value="@searchText" @oninput="OnSearchChanged"
                   placeholder="Filter repos by name…" />
            @if (searchText.Length > 0)
            {
                <span class="muted">@visibleCards.Count of @cards.Count</span>
            }
        </div>
        <div class="card totals-bar">
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.Stars)</span>
                <span class="total-label">★ Stars</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.Forks)</span>
                <span class="total-label">⑂ Forks</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.Watchers)</span>
                <span class="total-label">👁 Watchers</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.OpenIssues)</span>
                <span class="total-label">Open issues</span>
            </div>
            <div class="total">
                <span class="total-value">@cards.Sum(c => c.OpenPullRequests)</span>
                <span class="total-label">Open PRs</span>
            </div>
            <div class="total">
                <span class="total-value ok">@cards.Count(c => c.LatestRunSucceeded)</span>
                <span class="total-label">Builds passing</span>
            </div>
            <div class="total">
                <span class="total-value bad">@cards.Count(c => c.LatestRunFailed)</span>
                <span class="total-label">Builds failing</span>
            </div>
        </div>
        @if (visibleCards.Count == 0)
        {
            <div class="card empty-state">
                <p>No repos match “@searchText”.</p>
            </div>
        }
        <div class="repo-grid">
            @foreach (var card in visibleCards)
            {
                <div class="card repo-card @(dragKey == card.Key ? "dragging" : "")"
                     @key="card.Key"
                     draggable="true"
                     @ondragstart="() => dragKey = card.Key"
                     @ondragend="() => dragKey = null"
                     @ondragenter:preventDefault
                     @ondragover:preventDefault
                     @ondrop="() => OnDropOnAsync(card)">
                    <div class="repo-card-head">
                        <div style="min-width:0;">
                            <div class="repo-name repo-link" title="Open repository on GitHub"
                                 @onclick="() => Browser.OpenAsync(card.RepoUrl, BrowserLaunchMode.External)">@card.Title</div>
                            <div class="account-label">@card.AccountLabel</div>
                        </div>
                        <span class="move-buttons">
                            <button class="move-btn" title="Move earlier" disabled="@(cards.IndexOf(card) == 0)"
                                    @onclick="() => MoveCardAsync(card, -1)">‹</button>
                            <button class="move-btn" title="Move later" disabled="@(cards.IndexOf(card) == cards.Count - 1)"
                                    @onclick="() => MoveCardAsync(card, +1)">›</button>
                        </span>
                    </div>
                    <div class="pills">
                        <span class="pill-link" title="Open issues on GitHub"
                              @onclick="() => Browser.OpenAsync(card.IssuesUrl, BrowserLaunchMode.External)">
                            <Pill Text="@($"Issues {card.OpenIssues}")" Type="PillType.Info" />
                        </span>
                        <span class="pill-link" title="Open pull requests on GitHub"
                              @onclick="() => Browser.OpenAsync(card.PullsUrl, BrowserLaunchMode.External)">
                            <Pill Text="@($"PRs {card.OpenPullRequests}")" Type="PillType.Info" />
                        </span>
                    </div>
                    <div class="pills repo-stats">
                        <span class="stat stat-link" title="Open stargazers on GitHub"
                              @onclick="() => Browser.OpenAsync(card.StarsUrl, BrowserLaunchMode.External)">★ @card.Stars</span>
                        <span class="stat stat-link" title="Open forks on GitHub"
                              @onclick="() => Browser.OpenAsync(card.ForksUrl, BrowserLaunchMode.External)">⑂ @card.Forks</span>
                        <span class="stat stat-link" title="Open watchers on GitHub"
                              @onclick="() => Browser.OpenAsync(card.WatchersUrl, BrowserLaunchMode.External)">👁 @card.Watchers</span>
                    </div>
                    @if (card.LatestRunStatus is not null)
                    {
                        <div class="pills">
                            <span class="pill-link" title="Open this workflow run on GitHub"
                                  @onclick="() => Browser.OpenAsync(card.LatestRunUrl ?? card.ActionsUrl, BrowserLaunchMode.External)">
                                <Pill Text="@card.LatestRunStatus" Type="card.LatestRunPillType" />
                                <span class="run-desc">@card.LatestRunDescription</span>
                            </span>
                        </div>
                    }
                    @if (card.HasError)
                    {
                        <div class="error">@card.ErrorMessage</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    readonly List<RepoCardModel> cards = new();
    readonly List<InboxItem> inbox = new();
    readonly List<IDisposable> subs = new();

    bool isBusy;
    string? statusText;
    string? dragKey;
    string searchText = "";
    List<string> savedOrder = new();

    // The cards visible after applying the search filter. A blank search shows everything.
    IReadOnlyList<RepoCardModel> visibleCards =>
        searchText.Length == 0
            ? cards
            : cards
                .Where(c => c.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                         || c.AccountLabel.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();

    void OnSearchChanged(ChangeEventArgs e)
        => searchText = e.Value?.ToString() ?? "";

    protected override async Task OnInitializedAsync()
    {
        subs.Add(Mediator.Subscribe<SnapshotUpdatedEvent>(OnSnapshotUpdated));
        subs.Add(Mediator.Subscribe<InboxUpdatedEvent>(OnInboxUpdated));
        Config.Changed += OnConfigChanged;

        savedOrder = (await Config.GetRepoOrderAsync()).ToList();
        await Config.ReloadAsync();
        RebuildCards();
    }

    void RebuildCards()
    {
        var existing = cards.ToDictionary(c => c.Key);
        cards.Clear();

        var desired = Config.Accounts
            .SelectMany(a => a.Repos.Select(r => (Account: a, Repo: r)))
            .OrderBy(d =>
            {
                var i = savedOrder.IndexOf($"{d.Account.Id}|{d.Repo.FullName}");
                return i < 0 ? int.MaxValue : i;
            })
            .ToList();

        foreach (var (account, repo) in desired)
        {
            var key = $"{account.Id}|{repo.FullName}";
            if (!existing.TryGetValue(key, out var card))
            {
                card = new RepoCardModel(account, repo);
                var snap = Cache.TryGet(account.Id, repo);
                if (snap is not null)
                    card.Apply(snap);
            }
            cards.Add(card);
        }

        statusText = cards.Count == 0
            ? null
            : $"{cards.Count} repo{(cards.Count == 1 ? "" : "s")} monitored";
    }

    async Task OnDropOnAsync(RepoCardModel target)
    {
        if (dragKey is null || dragKey == target.Key)
            return;
        var dragged = cards.FirstOrDefault(c => c.Key == dragKey);
        dragKey = null;
        if (dragged is null)
            return;

        var from = cards.IndexOf(dragged);
        var to = cards.IndexOf(target);
        cards.RemoveAt(from);
        cards.Insert(to, dragged);
        await PersistOrderAsync();
    }

    async Task MoveCardAsync(RepoCardModel card, int delta)
    {
        var from = cards.IndexOf(card);
        var to = from + delta;
        if (from < 0 || to < 0 || to >= cards.Count)
            return;
        cards.RemoveAt(from);
        cards.Insert(to, card);
        await PersistOrderAsync();
    }

    Task PersistOrderAsync()
    {
        savedOrder = cards.Select(c => c.Key).ToList();
        return Config.SetRepoOrderAsync(savedOrder);
    }

    void OnConfigChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(() =>
        {
            RebuildCards();
            StateHasChanged();
        });

    Task OnSnapshotUpdated(SnapshotUpdatedEvent e, IMediatorContext _, CancellationToken __)
        => InvokeAsync(() =>
        {
            var key = $"{e.AccountId}|{e.Repo.FullName}";
            var card = cards.FirstOrDefault(c => c.Key == key);
            if (card is null)
                return;
            // Every poll re-snapshots every repo even when nothing moved; only
            // re-render when a displayed value actually changed, so an idle app
            // isn't pushing identical render batches into the WebView each minute.
            if (card.Apply(e.Snapshot))
                StateHasChanged();
        });

    Task OnInboxUpdated(InboxUpdatedEvent e, IMediatorContext _, CancellationToken __)
        => InvokeAsync(() =>
        {
            var merged = inbox
                .Where(i => i.AccountId != e.AccountId)
                .Concat(e.Items)
                .Where(i => i.Reason is InboxReason.Mention or InboxReason.Assigned or InboxReason.ReviewRequested)
                .OrderByDescending(i => i.UpdatedAt)
                .ToList();
            // InboxItem is a record, so SequenceEqual is a value comparison — skip
            // the re-render (and its WebView render batch) when the list is identical.
            if (merged.SequenceEqual(inbox))
                return;
            inbox.Clear();
            inbox.AddRange(merged);
            StateHasChanged();
        });

    async Task RefreshAsync()
    {
        if (isBusy)
            return;
        isBusy = true;
        try
        {
            await Mediator.Send(new RefreshAllCommand(true));
        }
        finally
        {
            isBusy = false;
        }
    }

    public void Dispose()
    {
        Config.Changed -= OnConfigChanged;
        foreach (var s in subs)
            s.Dispose();
    }
}
