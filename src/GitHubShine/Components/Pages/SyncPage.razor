@page "/sync"
@implements IDisposable
@inject ISyncStore SyncStore
@inject IConfigStore Config
@inject IRepoSyncEngine Engine
@inject IGitRuntime Git
@inject NavigationManager Nav
@inject IToastService Toast
@inject IBrowser Browser
@inject SnapshotCache Snapshots
@inject IGitProviderFactory Factory
@inject SyncGate Gate

<div class="page sync-page">
    <div class="page-header">
        <div class="header-text">
            <h1>Sync</h1>
            <span class="subtitle">Mirror a monitored repo to another server — creates the target repo if it's missing, then pushes whatever commits it's behind by.</span>
        </div>
        <span class="spacer"></span>
        <button class="btn" @onclick="@(() => Nav.NavigateTo("/sync/edit"))" disabled="@isBusy">+ Add sync</button>
        <button class="btn primary" @onclick="@(() => Nav.NavigateTo("/sync/bulk"))" disabled="@isBusy">Bulk add…</button>
    </div>

    @if (gitMissing)
    {
        <div class="card sync-warning">
            <strong>Git support isn't available</strong>
            <div class="meta">@gitMessage</div>
        </div>
    }

    @if (AutoSyncRunning)
    {
        <div class="card sync-warning">
            <strong>Auto-sync is running</strong>
            <div class="meta">
                A scheduled background run has these syncs. Its results land in this list as it goes —
                start your own run once it's finished.
            </div>
        </div>
    }

    @if (BlockedRows.Count > 0)
    {
        <div class="card sync-warning">
            <strong>@BlockedRows.Count sync@(BlockedRows.Count == 1 ? "" : "s") can't run</strong>
            <div class="meta">
                Each reads a repo its source account no longer monitors — usually left over from moving
                repos between accounts. Run all skips them. Move each to the account that does monitor it,
                or delete it.
            </div>
            @if (SupersededRows.Count > 0)
            {
                <div class="pills" style="margin-top:10px;">
                    @if (pendingCleanup)
                    {
                        <button class="btn danger" @onclick="CleanUpSupersededAsync" disabled="@isBusy">
                            Confirm — delete @SupersededRows.Count
                        </button>
                        <button class="btn" @onclick="() => pendingCleanup = false">Cancel</button>
                    }
                    else
                    {
                        <button class="btn danger" @onclick="() => pendingCleanup = true" disabled="@isBusy">
                            Delete @SupersededRows.Count already covered by another sync
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (rows.Count == 0)
    {
        <div class="card empty-state">
            <h2>No syncs configured</h2>
            <p>Pick repos you already monitor and a destination account — for example, backing up your GitHub repos onto a self-hosted Gitea server.</p>
            <div class="pills">
                <button class="btn primary" @onclick="@(() => Nav.NavigateTo("/sync/bulk"))">Bulk add many repos…</button>
                <button class="btn" @onclick="@(() => Nav.NavigateTo("/sync/edit"))">+ Add one</button>
            </div>
        </div>
    }
    else
    {
        <div class="card sync-toolbar-card">
            <div class="sync-toolbar">
                <span class="muted sync-toolbar-summary">
                    @rows.Count sync@(rows.Count == 1 ? "" : "s") configured
                    @if (BehindCount > 0)
                    {
                        <text> · </text><strong class="warn-text">@BehindCount behind</strong>
                    }
                    @if (NeverSyncedCount > 0)
                    {
                        <text> · @NeverSyncedCount never run</text>
                    }
                    @if (UpToDateCount > 0)
                    {
                        <text> · @UpToDateCount up to date</text>
                    }
                </span>
                <div class="sync-toolbar-actions">
                    <select value="@filter" @onchange="OnFilterChanged" disabled="@isBusy"
                            title="Show only the syncs in this state">
                        <option value="@RowFilter.All">All (@rows.Count)</option>
                        <option value="@RowFilter.Behind">Behind (@BehindCount)</option>
                        <option value="@RowFilter.NeverSynced">Never run (@NeverSyncedCount)</option>
                        <option value="@RowFilter.UpToDate">Up to date (@UpToDateCount)</option>
                        <option value="@RowFilter.NeedsAttention">Needs attention (@BlockedRows.Count)</option>
                    </select>
                    @if (isChecking)
                    {
                        <span class="spinner"></span>
                        <span class="muted">Checking @checkedCount/@checkTotal…</span>
                    }
                    else if (!isBusy)
                    {
                        <button class="btn" @onclick="CheckAllAsync"
                                title="Reads each source repo's last-push time and compares it with that sync's last run">
                            Check for changes
                        </button>
                    }
                    @if (isBusy)
                    {
                        <span class="spinner"></span>
                        <button class="btn danger" @onclick="Cancel">Cancel</button>
                    }
                    else
                    {
                        <button class="btn" @onclick="RunBehindAsync" disabled="@(isChecking || AutoSyncRunning || BehindCount == 0)"
                                title="@(BehindCount == 0
                                    ? "Nothing is known to be behind — run Check for changes first"
                                    : "Runs only the syncs whose source was pushed after their last run")">
                            Sync behind (@BehindCount)
                        </button>
                        <button class="btn primary" @onclick="RunVisibleAsync" disabled="@(isChecking || AutoSyncRunning || RunnableVisible.Count == 0)">
                            @(filter == RowFilter.All ? "Run all" : $"Run {RunnableVisible.Count} shown")
                        </button>
                    }
                </div>
            </div>

            @* The schedule gets its own line: it's about what happens while the app is closed,
               which is a different question from what the buttons above do right now. *@
            <div class="sync-toolbar sync-toolbar-schedule">
                <span class="muted sync-toolbar-summary">
                    @if (autoSync.Enabled)
                    {
                        <text>@AutoSyncSummary</text>
                        @if (ManualOnlyCount > 0)
                        {
                            <text> · </text>
                            <span title="These syncs only move when you run them here">
                                @ManualOnlyCount of @rows.Count set to manual only
                            </span>
                        }
                    }
                    else
                    {
                        <strong class="warn-text">Auto-sync is paused</strong>
                        <text> — nothing syncs on a schedule until you resume. Running syncs by hand still works.</text>
                    }
                </span>
                <div class="sync-toolbar-actions">
                    <button class="btn @(autoSync.Enabled ? "" : "primary")" @onclick="ToggleAutoSyncPausedAsync"
                            title="@(autoSync.Enabled
                                ? "Stops every scheduled run without touching each sync's own setting"
                                : "Puts the schedule back on — each sync's own auto-sync setting is unchanged")">
                        @(autoSync.Enabled ? "Pause auto-sync" : "Resume auto-sync")
                    </button>
                    <button class="btn" @onclick="() => SetAutoSyncForVisibleAsync(true)"
                            disabled="@(isBusy || VisibleAutoSyncOff.Count == 0)"
                            title="Turns auto-sync on for @BulkScope">
                        Auto-sync @BulkScope
                    </button>
                    <button class="btn" @onclick="() => SetAutoSyncForVisibleAsync(false)"
                            disabled="@(isBusy || VisibleAutoSyncOn.Count == 0)"
                            title="Leaves @BulkScope for you to run by hand">
                        Manual only
                    </button>
                </div>
            </div>
        </div>

        @if (VisibleRows.Count == 0)
        {
            <div class="card">
                <span class="muted">No syncs are @FilterLabel(filter).</span>
            </div>
        }

        @foreach (var row in VisibleRows)
        {
            <div class="card sync-row @(row.Blocked ? "sync-row-blocked" : "")" @key="row.Mapping.Id">
                @* Header: the route reads as the row's title, with the status badges pinned to the
                   right of it. Everything else lives in its own band below, so a long repo name can
                   wrap without dragging the facts or the buttons around with it. *@
                <div class="sync-head">
                    <div class="sync-route">
                        <strong>@row.Mapping.Source.FullName</strong>
                        <span class="sync-arrow">→</span>
                        <strong>@row.Mapping.TargetFullName</strong>
                    </div>

                    @* One badge at a time, most urgent first — a run result outranks the freshness
                       estimate it just made stale. Duplicate-destination is the only badge that can
                       stack, since it's about a different problem entirely. *@
                    <div class="sync-status">
                        @if (row.Status == RunStatus.Running)
                        {
                            <span class="spinner"></span>
                        }
                        else if (row.Status == RunStatus.Failed)
                        {
                            <span title="@row.Message"><Pill Text="Failed" Type="PillType.Critical" /></span>
                        }
                        else if (row.Blocked)
                        {
                            <span title="@row.Issue"><Pill Text="Needs attention" Type="PillType.Warning" /></span>
                        }
                        else if (row.Status == RunStatus.Done)
                        {
                            <Pill Text="Synced" Type="PillType.Success" />
                        }
                        else if (row.Freshness == SyncFreshness.Behind)
                        {
                            <span title="@row.FreshnessDetail"><Pill Text="Behind" Type="PillType.Warning" /></span>
                        }
                        else if (row.Freshness == SyncFreshness.UpToDate)
                        {
                            <span title="@row.FreshnessDetail"><Pill Text="Up to date" Type="PillType.Success" /></span>
                        }
                        else if (row.Freshness == SyncFreshness.NeverSynced)
                        {
                            <span title="@row.FreshnessDetail"><Pill Text="Never run" Type="PillType.Info" /></span>
                        }
                        else
                        {
                            @* Unknown: no push time to compare against. Still worth a badge — an
                               empty status column reads as "fine" when it means "no idea". *@
                            <span title="@row.FreshnessDetail"><Pill Text="Not checked" Type="PillType.None" /></span>
                        }

                        @if (row.DuplicateDestination is not null)
                        {
                            <span title="@($"{AccountLabel(row.DuplicateDestination.SourceAccountId)} also syncs {row.DuplicateDestination.Source.FullName} to this same destination")">
                                <Pill Text="Duplicate" Type="PillType.Warning" />
                            </span>
                        }
                    </div>
                </div>

                @* What this sync is configured to do — one chip per setting rather than a run-on
                   sentence, so the eye can skip the ones it doesn't care about. *@
                <div class="sync-tags">
                    <span class="sync-tag">
                        @AccountLabel(row.Mapping.SourceAccountId)
                        <span class="sync-arrow">→</span>
                        @AccountLabel(row.Mapping.TargetAccountId)
                    </span>
                    <span class="sync-tag">@row.Mapping.BranchSummary</span>
                    @if (row.Mapping.IncludeTags)
                    {
                        <span class="sync-tag">Tags</span>
                    }
                    @if (row.Mapping.Force)
                    {
                        <span class="sync-tag" title="Refs are force-updated on the target">Force</span>
                    }
                    @if (!row.Mapping.AutoSync)
                    {
                        <span class="sync-tag muted-tag" title="The scheduled background run skips this sync">Manual only</span>
                    }
                </div>

                @* The three timestamps that decide whether this sync has work to do, in a grid so
                   they line up across every row instead of hiding behind a toggle. *@
                <div class="sync-facts">
                    <div class="sync-fact">
                        <span class="sync-fact-label">Last run</span>
                        <span class="sync-fact-value" title="@LastRunText(row)">@LastRunValue(row)</span>
                        <span class="sync-fact-sub">@LastRunSub(row)</span>
                    </div>
                    <div class="sync-fact">
                        <span class="sync-fact-label">Source last push</span>
                        <span class="sync-fact-value" title="@PushedAtText(row)">@PushedValue(row)</span>
                        <span class="sync-fact-sub">@PushedSub(row)</span>
                    </div>
                    <div class="sync-fact">
                        <span class="sync-fact-label">Status</span>
                        <span class="sync-fact-value @(row.Freshness == SyncFreshness.Behind ? "warn-text" : "")">@FreshnessLabel(row)</span>
                        <span class="sync-fact-sub">@row.FreshnessDetail</span>
                    </div>
                </div>

                @if (row.Issue is not null)
                {
                    <div class="sync-issue">
                        @row.Issue
                        @if (row.SupersededBy is not null)
                        {
                            <text>
                                The @AccountLabel(row.SupersededBy.SourceAccountId) sync already covers
                                @row.Mapping.TargetFullName, so this one is safe to delete.
                            </text>
                        }
                        else if (row.RepointTo is not null)
                        {
                            <text>@row.Mapping.Source.FullName is monitored on @row.RepointTo.Label — move it there to fix this.</text>
                        }
                    </div>
                }

                @if (row.Log.Count > 0)
                {
                    <details class="sync-log">
                        <summary>Run log (@row.Log.Count)</summary>
                        @foreach (var line in row.Log)
                        {
                            <div>@line</div>
                        }
                    </details>
                }

                @* Footer: what this row can do. Running it and deciding whether it runs itself sit
                   together on the left; the links and the destructive edits keep to the right. *@
                <div class="sync-foot">
                    <div class="sync-foot-group">
                        <button class="btn primary" @onclick="() => RunOneAsync(row)"
                                disabled="@(isBusy || AutoSyncRunning || row.Blocked)"
                                title="@(row.Blocked ? row.Issue : "Push whatever the target is missing")">Sync now</button>
                        <label class="sync-check" title="@(row.Mapping.AutoSync
                            ? "The scheduled background run picks this sync up when the source has been pushed since it last ran"
                            : "The scheduled background run skips this sync — it only moves when you run it")">
                            <input type="checkbox" checked="@row.Mapping.AutoSync" disabled="@isBusy"
                                   @onchange="e => ToggleAutoSyncAsync(row, (bool)e.Value!)" />
                            <span>Auto-sync when behind</span>
                        </label>
                    </div>
                    <span class="spacer"></span>
                    <div class="sync-foot-group">
                        <button class="btn subtle" title="@(row.SourceUrl ?? "The source account is gone, so there's no link to open")"
                                @onclick="() => OpenAsync(row.SourceUrl)" disabled="@(row.SourceUrl is null)">Source ↗</button>
                        <button class="btn subtle" title="@(row.TargetUrl ?? "The destination account is gone, so there's no link to open")"
                                @onclick="() => OpenAsync(row.TargetUrl)" disabled="@(row.TargetUrl is null)">Target ↗</button>
                        @if (row.RepointTo is not null)
                        {
                            <button class="btn" @onclick="() => RepointAsync(row)" disabled="@isBusy">Move to @row.RepointTo.Label</button>
                        }
                        <button class="btn subtle" @onclick="@(() => Nav.NavigateTo($"/sync/edit/{row.Mapping.Id}"))" disabled="@isBusy">Edit</button>
                        @if (pendingDeleteId == row.Mapping.Id)
                        {
                            <button class="btn danger" @onclick="() => DeleteAsync(row.Mapping)">Confirm</button>
                            <button class="btn subtle" @onclick="() => pendingDeleteId = null">Cancel</button>
                        }
                        else
                        {
                            <button class="btn subtle danger" @onclick="() => pendingDeleteId = row.Mapping.Id" disabled="@isBusy">Delete</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    enum RunStatus { Idle, Running, Done, Failed }

    /// <summary>Which rows the list shows. Counts in the picker come from the same rules.</summary>
    enum RowFilter { All, Behind, NeverSynced, UpToDate, NeedsAttention }

    sealed class SyncRow(SyncMapping mapping)
    {
        public SyncMapping Mapping { get; set; } = mapping;
        public RunStatus Status { get; set; }
        public string? Message { get; set; }
        public List<string> Log { get; } = new();

        /// <summary>Why this mapping can't run, or null when it's healthy.</summary>
        public string? Issue { get; set; }

        /// <summary>The one account that does monitor the source repo, when there's exactly one.</summary>
        public MonitoredAccount? RepointTo { get; set; }

        /// <summary>A healthy mapping already pushing this same source repo to this same destination.</summary>
        public SyncMapping? SupersededBy { get; set; }

        /// <summary>Another mapping writing to the same destination repo, healthy or not.</summary>
        public SyncMapping? DuplicateDestination { get; set; }

        public string? SourceUrl { get; set; }
        public string? TargetUrl { get; set; }

        /// <summary>Last push to the source repo — from the poller's cache, or an explicit check.</summary>
        public DateTimeOffset? SourcePushedAt { get; set; }

        /// <summary>Set when the timestamp came from this page's own check rather than the cache.</summary>
        public bool Checked { get; set; }

        public SyncFreshness Freshness { get; set; }
        public string? FreshnessDetail { get; set; }

        public bool Blocked => this.Issue is not null;
    }

    readonly List<SyncRow> rows = new();
    bool isBusy;
    bool gitMissing;
    string gitMessage = "";
    string? pendingDeleteId;
    bool pendingCleanup;
    CancellationTokenSource? cts;

    bool isChecking;
    int checkedCount;
    int checkTotal;

    RowFilter filter = RowFilter.All;

    AutoSyncPrefs autoSync = AutoSyncPrefs.Default;

    /// <summary>True while the scheduled background run owns the gate — this page can't run then.</summary>
    bool AutoSyncRunning => Gate.Holder == SyncRunKind.Automatic;

    string AutoSyncSummary
    {
        get
        {
            if (!autoSync.Enabled)
                return "Auto-sync is paused";
            var scope = autoSync.SyncAll ? "everything" : "behind only";
            return $"Auto-sync every {autoSync.IntervalHours}h ({scope})";
        }
    }

    /// <summary>Syncs the schedule will never pick up, whatever the global switch says.</summary>
    int ManualOnlyCount => rows.Count(r => !r.Mapping.AutoSync);

    List<SyncRow> VisibleAutoSyncOn => VisibleRows.Where(r => r.Mapping.AutoSync).ToList();
    List<SyncRow> VisibleAutoSyncOff => VisibleRows.Where(r => !r.Mapping.AutoSync).ToList();

    /// <summary>What the bulk buttons say they'll touch — the same "all vs shown" rule as Run all.</summary>
    string BulkScope => filter == RowFilter.All
        ? $"all {rows.Count}"
        : $"the {VisibleRows.Count} shown";

    List<SyncRow> BlockedRows => rows.Where(r => r.Blocked).ToList();
    List<SyncRow> SupersededRows => rows.Where(r => r.Blocked && r.SupersededBy is not null).ToList();

    /// <summary>Rows whose source was pushed after their last run — what "Sync behind" runs.</summary>
    List<SyncRow> BehindRows => rows.Where(r => !r.Blocked && r.Freshness == SyncFreshness.Behind).ToList();

    int BehindCount => BehindRows.Count;
    int NeverSyncedCount => rows.Count(r => !r.Blocked && r.Freshness == SyncFreshness.NeverSynced);
    int UpToDateCount => rows.Count(r => !r.Blocked && r.Freshness == SyncFreshness.UpToDate);

    List<SyncRow> VisibleRows => rows.Where(Matches).ToList();

    /// <summary>The visible rows a run could actually touch — blocked ones would only fail.</summary>
    List<SyncRow> RunnableVisible => VisibleRows.Where(r => !r.Blocked).ToList();

    bool Matches(SyncRow row)
    {
        // A row this page has just run stays put whatever the filter says: syncing a "behind" row
        // makes it up to date, and having it (and its run log) vanish mid-run reads as a crash.
        if (row.Status != RunStatus.Idle)
            return true;

        return filter switch
        {
            RowFilter.Behind => !row.Blocked && row.Freshness == SyncFreshness.Behind,
            RowFilter.NeverSynced => !row.Blocked && row.Freshness == SyncFreshness.NeverSynced,
            RowFilter.UpToDate => !row.Blocked && row.Freshness == SyncFreshness.UpToDate,
            RowFilter.NeedsAttention => row.Blocked,
            _ => true
        };
    }

    static string FilterLabel(RowFilter value) => value switch
    {
        RowFilter.Behind => "behind — try Check for changes",
        RowFilter.NeverSynced => "waiting for a first run",
        RowFilter.UpToDate => "known to be up to date",
        RowFilter.NeedsAttention => "in need of attention",
        _ => "configured"
    };

    void OnFilterChanged(ChangeEventArgs e)
        => filter = Enum.TryParse<RowFilter>(e.Value?.ToString(), out var value) ? value : RowFilter.All;

    protected override async Task OnInitializedAsync()
    {
        SyncStore.Changed += OnStoreChanged;
        SyncStore.AutoSyncChanged += OnAutoSyncChanged;
        Gate.BusyChanged += OnGateChanged;
        await Config.ReloadAsync();
        await SyncStore.ReloadAsync();
        autoSync = await SyncStore.GetAutoSyncAsync();
        Rebuild();

        try
        {
            await Git.EnsureAvailableAsync();
        }
        catch (GitUnavailableException ex)
        {
            gitMissing = true;
            gitMessage = ex.Message;
        }
    }

    void Rebuild()
    {
        // Keep each row's last-run status/log across store reloads (a run writes its result back,
        // which raises Changed and would otherwise wipe the log the user is reading).
        var existing = rows.ToDictionary(r => r.Mapping.Id, StringComparer.Ordinal);
        var rebuilt = SyncStore.Mappings
            .OrderBy(m => m.Source.FullName, StringComparer.OrdinalIgnoreCase)
            .Select(m =>
            {
                if (existing.TryGetValue(m.Id, out var row))
                {
                    row.Mapping = m;
                    return row;
                }
                return new SyncRow(m);
            })
            .ToList();

        rows.Clear();
        rows.AddRange(rebuilt);

        foreach (var row in rows)
            Evaluate(row);
    }

    /// <summary>
    /// Works out up-front what <see cref="RepoSyncEngine"/> would only discover mid-run: a missing
    /// account, a source repo that's no longer monitored, or a second mapping aimed at the same
    /// destination repo. Also caches the two web links, which depend on the accounts.
    /// </summary>
    void Evaluate(SyncRow row)
    {
        var mapping = row.Mapping;
        row.Issue = null;
        row.RepointTo = null;
        row.SupersededBy = null;
        row.DuplicateDestination = null;

        var source = Config.Accounts.FirstOrDefault(a => a.Id == mapping.SourceAccountId);
        var target = Config.Accounts.FirstOrDefault(a => a.Id == mapping.TargetAccountId);

        row.SourceUrl = source is null ? null : SyncStatus.RepoUrl(source, mapping.Source);
        row.TargetUrl = target is null ? null : SyncStatus.RepoUrl(target, mapping.TargetRepo);

        // Shared with the background runner, so a row the page calls runnable is exactly one
        // AutoSyncRunner would pick up.
        row.Issue = SyncStatus.BlockingIssue(mapping, Config.Accounts);

        if (row.Issue is not null)
        {
            var candidates = Config.Accounts.Where(a => Monitors(a, mapping.Source)).ToList();
            if (candidates.Count == 1 && candidates[0].Id != mapping.SourceAccountId && target is not null)
                row.RepointTo = candidates[0];
        }

        // Same source repo, same destination repo, different mapping — and the other one can
        // actually run. That's the "left over from reorganising accounts" case, safe to delete.
        row.SupersededBy = SyncStore.Mappings.FirstOrDefault(m =>
            m.Id != mapping.Id &&
            SameDestination(m, mapping) &&
            string.Equals(m.Source.FullName, mapping.Source.FullName, StringComparison.OrdinalIgnoreCase) &&
            Config.Accounts.FirstOrDefault(a => a.Id == m.SourceAccountId) is { } other &&
            Monitors(other, m.Source));

        // Any other mapping writing to the same target repo, even from a different source: two
        // syncs racing at one destination overwrite each other, so it's worth surfacing.
        row.DuplicateDestination = SyncStore.Mappings.FirstOrDefault(m =>
            m.Id != mapping.Id && SameDestination(m, mapping));

        // Free: the dashboard poller already stores the source repo's last push. An explicit
        // check (row.Checked) wins, since it's newer than whatever the last poll left behind.
        if (!row.Checked)
            row.SourcePushedAt = Snapshots.TryGet(mapping.SourceAccountId, mapping.Source)?.PushedAt;

        EvaluateFreshness(row);
    }

    /// <summary>
    /// Classifies the row with <see cref="SyncStatus.Evaluate"/> — the same rule the background
    /// runner uses to pick what to sync — and writes the wording that goes with the verdict.
    /// </summary>
    static void EvaluateFreshness(SyncRow row)
    {
        var lastRun = row.Mapping.LastSyncedUtc;
        var pushed = row.SourcePushedAt;

        row.Freshness = SyncStatus.Evaluate(lastRun, pushed);
        row.FreshnessDetail = row.Freshness switch
        {
            SyncFreshness.NeverSynced => "This sync has never run.",
            SyncFreshness.Unknown => "No last-push time for the source yet — use Check for changes.",
            SyncFreshness.Behind => $"Pushed {Ago(pushed!.Value)}, {Humanise(pushed.Value - lastRun!.Value)} after the last run.",
            _ => $"Last run {Ago(lastRun!.Value)}; no push to the source since."
        };
    }

    // The facts grid wants a short value with the detail underneath it, rather than one long
    // sentence per cell — the columns only line up if every value is roughly the same width.

    static string LastRunValue(SyncRow row)
        => row.Status == RunStatus.Running
            ? "Running…"
            : row.Mapping.LastSyncedUtc is { } when ? Ago(when) : "Never";

    static string LastRunSub(SyncRow row)
    {
        if (row.Status == RunStatus.Running)
            return row.Message ?? "Working…";
        if (row.Mapping.LastSyncedUtc is not { } when)
            return "No first run yet";
        return row.Mapping.LastResult ?? when.ToLocalTime().ToString("g");
    }

    static string PushedValue(SyncRow row)
        => row.SourcePushedAt is { } when ? Ago(when) : "Unknown";

    static string PushedSub(SyncRow row)
    {
        if (row.SourcePushedAt is not { } when)
            return "Nothing has polled or checked this repo";
        return row.Checked
            ? when.ToLocalTime().ToString("g")
            : $"{when.ToLocalTime():g} — from the last poll";
    }

    static string PushedAtText(SyncRow row)
        => row.SourcePushedAt is { } when
            ? $"{when.ToLocalTime():g} ({Ago(when)}){(row.Checked ? "" : " — from the last dashboard poll")}"
            : "Unknown — nothing polled or checked this repo yet";

    static string FreshnessLabel(SyncRow row) => row.Freshness switch
    {
        SyncFreshness.Behind => "Behind",
        SyncFreshness.UpToDate => "Up to date",
        SyncFreshness.NeverSynced => "Never run",
        _ => "Unknown"
    };

    static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        return span < TimeSpan.Zero ? "just now" : Humanise(span) + " ago";
    }

    static string Humanise(TimeSpan span) => span.TotalMinutes switch
    {
        < 1 => "moments",
        < 60 => $"{(int)span.TotalMinutes}m",
        < 60 * 24 => $"{(int)span.TotalHours}h",
        < 60 * 24 * 30 => $"{(int)span.TotalDays}d",
        _ => $"{(int)(span.TotalDays / 30)}mo"
    };

    static bool Monitors(MonitoredAccount account, MonitoredRepo repo)
        => SyncStatus.Monitors(account, repo);

    static bool SameDestination(SyncMapping a, SyncMapping b)
        => a.TargetAccountId == b.TargetAccountId &&
           string.Equals(a.TargetFullName, b.TargetFullName, StringComparison.OrdinalIgnoreCase);

    void OnStoreChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(() =>
        {
            Rebuild();
            StateHasChanged();
        });

    void OnAutoSyncChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(async () =>
        {
            autoSync = await SyncStore.GetAutoSyncAsync();
            StateHasChanged();
        });

    // The background runner takes and releases the gate off the UI thread — repaint so the banner
    // and the run buttons follow it.
    void OnGateChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    string AccountLabel(string accountId)
        => Config.Accounts.FirstOrDefault(a => a.Id == accountId)?.Label ?? "(deleted account)";

    static string LastRunText(SyncRow row)
    {
        if (row.Status == RunStatus.Running)
            return row.Message ?? "Working…";
        if (row.Mapping.LastSyncedUtc is not { } when)
            return "Never run";
        return $"{row.Mapping.LastResult ?? "Ran"} — {when.ToLocalTime():g}";
    }

    void Cancel() => cts?.Cancel();

    Task RunOneAsync(SyncRow row) => RunAsync(new[] { row });

    /// <summary>
    /// Runs what the list is currently showing, so a filtered view and its button agree. With no
    /// filter that's every sync, which is what "Run all" has always meant.
    /// </summary>
    async Task RunVisibleAsync()
    {
        // Blocked rows would each throw from the engine and record a failure that says nothing the
        // banner hasn't already said, so leave them out and report the count instead.
        var visible = VisibleRows;
        var runnable = visible.Where(r => !r.Blocked).ToList();
        var skipped = visible.Count - runnable.Count;

        if (runnable.Count == 0)
        {
            await Toast.InfoAsync($"Nothing to run — all {skipped} sync{(skipped == 1 ? "" : "s")} need attention first");
            return;
        }

        await RunAsync(runnable, skipped);
    }

    /// <summary>
    /// Runs only the syncs whose source has been pushed since their last run. "Behind" comes from
    /// the same push-time heuristic the badges use, so it's only as fresh as the last poll or
    /// Check for changes — never-run syncs are deliberately not included; they have their own filter.
    /// </summary>
    async Task RunBehindAsync()
    {
        var behind = BehindRows;
        if (behind.Count == 0)
        {
            await Toast.InfoAsync("Nothing is known to be behind — run Check for changes first");
            return;
        }

        await RunAsync(behind);
    }

    async Task RunAsync(IReadOnlyList<SyncRow> targets, int skipped = 0)
    {
        if (isBusy || targets.Count == 0)
            return;

        // One run at a time process-wide: the scheduled background run may already have these
        // mappings, and two passes interleaving over the same cache repos helps nobody.
        using var lease = Gate.TryAcquire(SyncRunKind.Manual);
        if (lease is null)
        {
            await Toast.InfoAsync("Auto-sync is running right now — try again when it's finished");
            StateHasChanged();
            return;
        }

        pendingDeleteId = null;
        cts = new CancellationTokenSource();
        isBusy = true;
        var failures = 0;

        try
        {
            // Sequential: syncs are network- and disk-heavy, and two runs sharing a source would
            // contend on the same local cache repo.
            foreach (var row in targets)
            {
                cts.Token.ThrowIfCancellationRequested();
                row.Status = RunStatus.Running;
                row.Message = null;
                row.Log.Clear();
                StateHasChanged();

                var progress = new Progress<string>(line =>
                {
                    row.Log.Add(line);
                    row.Message = line;
                    StateHasChanged();
                });

                try
                {
                    await Engine.SyncAsync(row.Mapping, progress, cts.Token);
                    row.Status = RunStatus.Done;
                    row.Message = null;
                }
                catch (OperationCanceledException)
                {
                    row.Status = RunStatus.Idle;
                    row.Message = null;
                    throw;
                }
                catch (Exception ex)
                {
                    row.Status = RunStatus.Failed;
                    row.Message = ex.Message;
                    row.Log.Add(ex.Message);
                    failures++;
                }
                StateHasChanged();
            }

            var skippedNote = skipped == 0 ? "" : $" ({skipped} skipped — needs attention)";
            if (failures == 0)
                await Toast.SuccessAsync($"Synced {targets.Count} repo{(targets.Count == 1 ? "" : "s")}{skippedNote}");
            else
                await Toast.DangerAsync($"{targets.Count - failures} of {targets.Count} synced, {failures} failed{skippedNote} — open the run log for details");
        }
        catch (OperationCanceledException)
        {
            await Toast.InfoAsync("Sync cancelled");
        }
        finally
        {
            isBusy = false;
            cts?.Dispose();
            cts = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Flips this one mapping's auto-sync flag. Saved immediately — a checkbox that needed a Save
    /// button would be the only setting on the page that did — and the store's Changed event
    /// rebuilds the row in place, keeping its run log.
    /// </summary>
    async Task ToggleAutoSyncAsync(SyncRow row, bool value)
    {
        if (row.Mapping.AutoSync == value)
            return;

        try
        {
            await SyncStore.UpsertAsync(row.Mapping with { AutoSync = value });
        }
        catch (Exception ex)
        {
            await Toast.DangerAsync($"Couldn't save that: {ex.Message}");
        }
    }

    /// <summary>
    /// Pauses or resumes the whole schedule. Deliberately separate from the per-sync checkboxes:
    /// pausing is meant to be undone, so it must not overwrite the choices each sync already
    /// carries. It's the same flag as Settings → Automatic sync, saved the same way.
    /// </summary>
    async Task ToggleAutoSyncPausedAsync()
    {
        var enabled = !autoSync.Enabled;
        try
        {
            // Clear any back-off on the way back in, so resuming doesn't sit out an hour the
            // paused schedule had already booked.
            var updated = autoSync with
            {
                Enabled = enabled,
                RetryAfterUtc = enabled ? null : autoSync.RetryAfterUtc
            };

            // Adopt it here rather than waiting for AutoSyncChanged to land: the toast below
            // reads the summary, and the event handler is an async hop behind.
            autoSync = updated;
            await SyncStore.SaveAutoSyncAsync(updated);

            // Pausing isn't a success, it's a state change the user should be able to see they made.
            if (enabled)
                await Toast.SuccessAsync($"Auto-sync resumed — {AutoSyncSummary.ToLowerInvariant()}");
            else
                await Toast.InfoAsync("Auto-sync paused — nothing will sync on a schedule");
        }
        catch (Exception ex)
        {
            await Toast.DangerAsync($"Couldn't save that: {ex.Message}");
        }
    }

    /// <summary>
    /// Sets every visible sync's own auto-sync flag at once. Scoped to the filter for the same
    /// reason Run all is: what the list is showing is what the buttons act on.
    /// </summary>
    async Task SetAutoSyncForVisibleAsync(bool value)
    {
        var changing = VisibleRows.Where(r => r.Mapping.AutoSync != value).Select(r => r.Mapping).ToList();
        if (changing.Count == 0)
            return;

        try
        {
            await SyncStore.UpsertManyAsync(changing.Select(m => m with { AutoSync = value }).ToList());
            await Toast.SuccessAsync(value
                ? $"{changing.Count} sync{(changing.Count == 1 ? "" : "s")} will now sync automatically when behind"
                : $"{changing.Count} sync{(changing.Count == 1 ? "" : "s")} set to manual only");
        }
        catch (Exception ex)
        {
            await Toast.DangerAsync($"Couldn't save that: {ex.Message}");
        }
    }

    async Task DeleteAsync(SyncMapping mapping)
    {
        pendingDeleteId = null;
        await SyncStore.RemoveAsync(mapping.Id);
        await Toast.SuccessAsync($"Removed sync for {mapping.Source.FullName}");
    }

    /// <summary>
    /// Repoints a mapping at the account that actually monitors its source repo. The previous
    /// run result goes with it — it described the old, broken pairing.
    /// </summary>
    async Task RepointAsync(SyncRow row)
    {
        var account = row.RepointTo!;
        var mapping = row.Mapping;

        if (SyncStore.Mappings.Any(m =>
                m.Id != mapping.Id &&
                m.SourceAccountId == account.Id &&
                string.Equals(m.Source.FullName, mapping.Source.FullName, StringComparison.OrdinalIgnoreCase) &&
                SameDestination(m, mapping)))
        {
            await Toast.DangerAsync($"{account.Label} already syncs {mapping.Source.FullName} to {mapping.TargetFullName} — delete this one instead");
            return;
        }

        await SyncStore.UpsertAsync(mapping with
        {
            SourceAccountId = account.Id,
            LastSyncedUtc = null,
            LastResult = null
        });
        await Toast.SuccessAsync($"{mapping.Source.FullName} now syncs from {account.Label}");
    }

    async Task CleanUpSupersededAsync()
    {
        pendingCleanup = false;
        var doomed = SupersededRows.Select(r => r.Mapping).ToList();

        foreach (var mapping in doomed)
            await SyncStore.RemoveAsync(mapping.Id);

        await Toast.SuccessAsync($"Removed {doomed.Count} sync{(doomed.Count == 1 ? "" : "s")} already covered by another");
    }

    /// <summary>
    /// Fills in each source repo's last-push time. One request per distinct source repo — repos
    /// the poller has already cached are skipped, and duplicate sources across mappings share a
    /// single request, so the common case is a handful of conditional GETs that mostly 304.
    /// </summary>
    async Task CheckAllAsync()
    {
        if (isChecking || isBusy)
            return;

        var pending = rows
            .Where(r => !r.Blocked)
            .GroupBy(r => $"{r.Mapping.SourceAccountId}|{r.Mapping.Source.FullName}")
            .ToList();

        isChecking = true;
        checkedCount = 0;
        checkTotal = pending.Count;
        var failures = 0;

        try
        {
            foreach (var group in pending)
            {
                var first = group.First();
                var account = Config.Accounts.FirstOrDefault(a => a.Id == first.Mapping.SourceAccountId);
                if (account is null)
                    continue;

                try
                {
                    var provider = await Factory.CreateAsync(account);
                    var info = provider is null
                        ? null
                        : await provider.GetRepoInfoAsync(first.Mapping.Source);

                    foreach (var row in group)
                    {
                        row.SourcePushedAt = info?.PushedAt;
                        row.Checked = true;
                        EvaluateFreshness(row);
                    }
                }
                catch (Exception)
                {
                    // One unreachable repo shouldn't abandon the sweep — the row just stays Unknown.
                    failures++;
                }

                checkedCount++;
                StateHasChanged();
            }

            var behind = BehindCount;
            var note = failures == 0 ? "" : $" ({failures} couldn't be read)";
            if (behind == 0)
                await Toast.SuccessAsync($"Everything's up to date{note}");
            else
                await Toast.InfoAsync($"{behind} sync{(behind == 1 ? " is" : "s are")} behind{note}");
        }
        finally
        {
            isChecking = false;
            StateHasChanged();
        }
    }

    async Task OpenAsync(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return;

        try
        {
            await Browser.OpenAsync(url, BrowserLaunchMode.External);
        }
        catch (Exception ex)
        {
            await Toast.DangerAsync($"Couldn't open {url}: {ex.Message}");
        }
    }

    public void Dispose()
    {
        SyncStore.Changed -= OnStoreChanged;
        SyncStore.AutoSyncChanged -= OnAutoSyncChanged;
        Gate.BusyChanged -= OnGateChanged;
        cts?.Cancel();
        cts?.Dispose();
    }
}
