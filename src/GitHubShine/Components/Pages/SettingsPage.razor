@page "/settings"
@implements IDisposable
@inject IConfigStore Config
@inject IToastService Toast
@inject IDatabaseBackup Backup
@inject IFileDialogs FileDialogs
@inject INotificationHub Notifications
@inject INotificationPrefsStore NotifyPrefs
@inject ISyncStore SyncStore
@inject AppPlatformInfo Platform
@using Shiny
@using Shiny.Notifications

<div class="page narrow">
    <div class="page-header">
        <div>
            <h1>Settings</h1>
            <span class="subtitle">Notifications, alert categories, refresh interval, and backups.</span>
        </div>
    </div>

    <div class="card">
        <h2>Notifications</h2>
        <div class="setting-row">
            <div class="setting-label">
                <div><strong>System permission</strong></div>
                <div class="hint">
                    @if (access == AccessState.Available)
                    {
                        <text>macOS is allowing GitHub Shine to post notifications.</text>
                    }
                    else if (access is AccessState.Denied or AccessState.Disabled)
                    {
                        <text>
                            Blocked by the system, so no alerts can be shown. Turn it back on in
                            System Settings → Notifications → GitHub Shine.
                        </text>
                    }
                    else
                    {
                        <text>Permission hasn't been granted yet — alerts stay hidden until it is.</text>
                    }
                </div>
            </div>
            <div class="pills">
                <Pill Text="@AccessLabel" Type="@AccessPill" />
                @if (access != AccessState.Available)
                {
                    <button class="btn" @onclick="RequestAccessAsync" disabled="@isBusyNotify">Request…</button>
                }
            </div>
        </div>

        <div class="setting-row">
            <div class="setting-label">
                <div><strong>Mute everything</strong></div>
                <div class="hint">
                    Silences every category below without turning any of them off — flip it back and
                    your per-category choices are exactly as you left them.
                </div>
            </div>
            <label class="switch">
                <input type="checkbox" checked="@muted" @onchange="OnMuteChanged" />
                <span class="track"></span>
            </label>
        </div>

        <div class="setting-row">
            <div class="setting-label">
                <div><strong>Test notification</strong></div>
                <div class="hint">Posts a sample alert now, so you can confirm the whole path works.</div>
            </div>
            <button class="btn" @onclick="SendTestAsync" disabled="@isBusyNotify">Send test</button>
        </div>
    </div>

    <div class="card">
        <h2>Alert categories</h2>
        <p class="hint" style="margin-top:0;">
            @if (muted)
            {
                <text>Everything is muted right now — these switches take effect once you unmute.</text>
            }
            else
            {
                <text>Each kind of alert can be switched off on its own. Changes apply from the next refresh cycle.</text>
            }
        </p>
        @foreach (var category in NotificationCategoryInfo.All)
        {
            var current = category;
            <div class="setting-row">
                <div class="setting-label">
                    <div><strong>@NotificationCategoryInfo.Label(current)</strong></div>
                    <div class="hint">@NotificationCategoryInfo.Description(current)</div>
                </div>
                <label class="switch">
                    <input type="checkbox"
                           checked="@notify.IsCategoryOn(current)"
                           disabled="@muted"
                           @onchange="e => OnCategoryChangedAsync(current, e)" />
                    <span class="track"></span>
                </label>
            </div>
        }
    </div>

    <div class="card">
        <h2>Refresh</h2>
        @if (Platform.IsMobile)
        {
            @* The picker would be a lie here: on a phone the refresh runs as an OS-scheduled
               background job on a fixed long interval, and the operating system decides when it
               actually fires. Offering "2 minutes" would promise something neither iOS nor
               Android will honour. *@
            <div class="setting-row">
                <div class="setting-label">
                    <div><strong>Background refresh</strong></div>
                    <div class="hint">
                        Checks your accounts about every @MobileIntervalHours hours in the background, and whenever
                        you open the app. The exact timing is up to the operating system, which
                        holds background work back to protect battery life.
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="setting-row">
                <div class="setting-label">
                    <div><strong>Refresh interval</strong></div>
                    <div class="hint">How often GitHub Shine polls your accounts for fresh data. Applies on the next refresh cycle.</div>
                </div>
                <select value="@pollSeconds" @onchange="OnIntervalChanged">
                    @foreach (var seconds in intervalOptions)
                    {
                        <option value="@seconds">@IntervalLabel(seconds)</option>
                    }
                </select>
            </div>
        }
    </div>

    @* Sync is a desktop-only workflow and its page is hidden on mobile, so there's no schedule
       to configure there. *@
    @if (!Platform.IsMobile)
    {
        <div class="card">
            <h2>Automatic sync</h2>
            <div class="setting-row">
                <div class="setting-label">
                    <div><strong>Sync in the background</strong></div>
                    <div class="hint">
                        Runs the syncs configured on the Sync page on a schedule, without opening it.
                        A run in progress is left alone — the schedule picks up on the next slot.
                        Turning this off pauses every scheduled run; individual syncs can also opt out
                        on their own, from the Sync page.
                    </div>
                </div>
                <label class="switch">
                    <input type="checkbox" checked="@autoSync.Enabled" @onchange="OnAutoSyncEnabledChanged" />
                    <span class="track"></span>
                </label>
            </div>

            @if (autoSync.Enabled)
            {
                <div class="setting-row">
                    <div class="setting-label">
                        <div><strong>How often</strong></div>
                        <div class="hint">
                            Timed from the last background run, so closing and re-opening the app doesn't
                            restart the clock. Three hours is the minimum — a sync fetches and pushes real
                            objects, unlike a dashboard refresh.
                        </div>
                    </div>
                    <select value="@autoSync.IntervalHours" @onchange="OnAutoSyncIntervalChanged">
                        @foreach (var hours in autoSyncIntervalOptions)
                        {
                            <option value="@hours">@HoursLabel(hours)</option>
                        }
                    </select>
                </div>

                <div class="setting-row">
                    <div class="setting-label">
                        <div><strong>Sync everything each run</strong></div>
                        <div class="hint">
                            Off, each run only touches the repos whose source has been pushed since that
                            sync last ran, plus any that have never run. On, it runs every configured
                            sync — slower and more traffic, but it doesn't depend on last-push times
                            being readable.
                        </div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" checked="@autoSync.SyncAll" @onchange="OnAutoSyncAllChanged" />
                        <span class="track"></span>
                    </label>
                </div>
            }

            <p class="hint" style="margin-bottom:0;">@AutoSyncStatus</p>
        </div>
    }

    <div class="card">
        <h2>Backup &amp; Restore</h2>
        <p class="hint" style="margin-top:0;">
            A backup is a single database file containing your accounts, repositories, access tokens,
            and card order. It includes your tokens — keep it private.
        </p>
        <div class="actions-bar" style="margin-top:0;">
            <button class="btn" @onclick="BackupAsync">Back up…</button>
            <button class="btn" @onclick="RestoreAsync">Restore…</button>
        </div>
    </div>
</div>

@code {
    NotificationPrefs notify = NotificationPrefs.Default;
    bool muted;
    int pollSeconds = 60;
    AccessState access = AccessState.Unknown;
    bool isBusyNotify;

    static readonly int[] presetIntervals = { 15, 30, 60, 120, 300, 600, 900, 1800, 3600 };
    int[] intervalOptions = presetIntervals;

    // Shown instead of the interval picker on mobile — sourced from the schedule itself so the
    // copy can't drift from the value the job actually enforces.
    static int MobileIntervalHours => (int)PollSchedule.MobileInterval.TotalHours;

    AutoSyncPrefs autoSync = AutoSyncPrefs.Default;
    static readonly int[] presetAutoSyncHours = { 3, 4, 6, 8, 12, 24, 48 };
    int[] autoSyncIntervalOptions = presetAutoSyncHours;

    string AutoSyncStatus
    {
        get
        {
            if (!autoSync.Enabled)
                return "Automatic sync is off — the Sync page still runs on demand.";

            var last = autoSync.LastRunUtc is { } when
                ? $"Last background run {Ago(when)}."
                : "No background run yet.";
            var next = autoSync.LastRunUtc is { } prev
                ? $" Next due {DueLabel(prev + autoSync.Interval)}."
                : "";
            return last + next;
        }
    }

    string AccessLabel => access switch
    {
        AccessState.Available => "Allowed",
        AccessState.Denied => "Denied",
        AccessState.Disabled => "Disabled",
        AccessState.Restricted => "Restricted",
        AccessState.NotSetup => "Not requested",
        AccessState.NotSupported => "Unsupported",
        _ => "Unknown"
    };

    PillType AccessPill => access switch
    {
        AccessState.Available => PillType.Success,
        AccessState.Denied or AccessState.Disabled => PillType.Critical,
        _ => PillType.Warning
    };

    protected override async Task OnInitializedAsync()
    {
        Config.PreferencesChanged += OnPreferencesChanged;
        // The tray menu can mute from outside this page — keep the switch honest.
        NotifyPrefs.Changed += OnPreferencesChanged;
        await LoadAsync();
    }

    async Task RequestAccessAsync()
    {
        isBusyNotify = true;
        try
        {
            access = await Notifications.RequestAsync();
            if (access == AccessState.Available)
                await Toast.SuccessAsync("Notifications enabled");
            else
                await Toast.DangerAsync($"Notification permission is {AccessLabel} — enable it in System Settings → Notifications");
        }
        finally
        {
            isBusyNotify = false;
        }
    }

    async Task SendTestAsync()
    {
        isBusyNotify = true;
        try
        {
            access = await Notifications.EnsureAsync();
            if (access != AccessState.Available)
            {
                await Toast.DangerAsync($"Can't send — notification permission is {AccessLabel}");
                return;
            }

            var sent = await Notifications.SendAsync(new Notification
            {
                Id = 999_001,
                Title = "GitHub Shine",
                Message = "Test notification — alerts are working."
            });
            if (sent)
                await Toast.SuccessAsync("Test notification sent");
            else
                await Toast.DangerAsync("Send failed — see the app log for details");
        }
        catch (Exception ex)
        {
            await Toast.DangerAsync($"Send failed: {ex.Message}");
        }
        finally
        {
            isBusyNotify = false;
        }
    }

    async Task LoadAsync()
    {
        access = await Notifications.CheckAsync();
        notify = await NotifyPrefs.GetAsync();
        muted = notify.Muted;
        pollSeconds = (int)(await Config.GetPollIntervalAsync()).TotalSeconds;
        // A stored value from an older build might not match a preset — show it anyway.
        intervalOptions = presetIntervals.Contains(pollSeconds)
            ? presetIntervals
            : presetIntervals.Append(pollSeconds).OrderBy(s => s).ToArray();

        autoSync = await SyncStore.GetAutoSyncAsync();
        autoSyncIntervalOptions = presetAutoSyncHours.Contains(autoSync.IntervalHours)
            ? presetAutoSyncHours
            : presetAutoSyncHours.Append(autoSync.IntervalHours).OrderBy(h => h).ToArray();
    }

    async Task SaveAutoSyncAsync(AutoSyncPrefs updated)
    {
        autoSync = updated;
        await SyncStore.SaveAutoSyncAsync(updated);
    }

    Task OnAutoSyncEnabledChanged(ChangeEventArgs e)
        => SaveAutoSyncAsync(autoSync with { Enabled = (bool)e.Value! });

    Task OnAutoSyncAllChanged(ChangeEventArgs e)
        => SaveAutoSyncAsync(autoSync with { SyncAll = (bool)e.Value! });

    async Task OnAutoSyncIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var hours))
            await SaveAutoSyncAsync(autoSync with { IntervalHours = Math.Max(AutoSyncPrefs.MinimumIntervalHours, hours) });
    }

    static string HoursLabel(int hours) => hours switch
    {
        1 => "Every hour",
        < 24 => $"Every {hours} hours",
        24 => "Once a day",
        48 => "Every 2 days",
        _ => $"Every {hours / 24} days"
    };

    static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        return span < TimeSpan.Zero ? "just now" : $"{Humanise(span)} ago";
    }

    // Rounds up, unlike Ago: "in 2h" for a run that's 2h58m off reads as an hour early.
    static string DueLabel(DateTimeOffset when)
    {
        var span = when - DateTimeOffset.UtcNow;
        if (span <= TimeSpan.Zero)
            return "now";
        if (span < TimeSpan.FromMinutes(1))
            return "in moments";
        return span < TimeSpan.FromHours(1)
            ? $"in {Math.Ceiling(span.TotalMinutes)}m"
            : $"in {Math.Ceiling(span.TotalHours)}h";
    }

    static string Humanise(TimeSpan span) => span.TotalMinutes switch
    {
        < 1 => "moments",
        < 60 => $"{(int)span.TotalMinutes}m",
        < 60 * 24 => $"{(int)span.TotalHours}h",
        _ => $"{(int)span.TotalDays}d"
    };

    void OnPreferencesChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });

    async Task OnMuteChanged(ChangeEventArgs e)
    {
        muted = (bool)e.Value!;
        notify = notify with { Muted = muted };
        await NotifyPrefs.SaveAsync(notify);
    }

    async Task OnCategoryChangedAsync(NotificationCategory category, ChangeEventArgs e)
    {
        notify = notify.With(category, (bool)e.Value!);
        await NotifyPrefs.SaveAsync(notify);
    }

    async Task OnIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
        {
            pollSeconds = seconds;
            await Config.SetPollIntervalAsync(TimeSpan.FromSeconds(seconds));
        }
    }

    static string IntervalLabel(int seconds) => seconds switch
    {
        < 60 => $"{seconds} seconds",
        60 => "1 minute",
        < 3600 => $"{seconds / 60} minutes",
        3600 => "1 hour",
        _ => $"{seconds / 3600} hours",
    };

    async Task BackupAsync()
    {
        try
        {
            var path = await FileDialogs.PickSavePathAsync($"githubshine-backup-{DateTime.Now:yyyyMMdd}.db");
            if (path is null)
                return;
            await Backup.BackupToAsync(path);
            // Desktop wrote to the user's chosen location (returns false → confirm with the path).
            // Mobile staged a temp file and hands it to the share sheet (returns true → that's the confirmation).
            var handedToShareSheet = await FileDialogs.PresentSavedFileAsync(path, "GitHub Shine backup");
            if (!handedToShareSheet)
                await Toast.SuccessAsync($"Backed up to {path} — contains your tokens, keep it private");
        }
        catch (Exception ex)
        {
            await Toast.DangerAsync($"Backup failed: {ex.Message}");
        }
    }

    async Task RestoreAsync()
    {
        try
        {
            var path = await FileDialogs.PickOpenPathAsync();
            if (path is null)
                return;
            var rows = await Backup.RestoreFromAsync(path);
            await Toast.SuccessAsync($"Restored {rows} record(s) — accounts, tokens and card order included");
        }
        catch (Exception ex)
        {
            await Toast.DangerAsync($"Restore failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        Config.PreferencesChanged -= OnPreferencesChanged;
        NotifyPrefs.Changed -= OnPreferencesChanged;
    }
}
