@page "/repos"
@implements IDisposable
@inject IMediator Mediator
@inject IConfigStore Config
@inject SnapshotCache Cache
@inject NavigationManager Nav
@inject IBrowser Browser

<div class="page">
    <div class="page-header">
        <div>
            <h1>Repositories</h1>
            <span class="subtitle">@Subtitle</span>
        </div>
        <span class="spacer"></span>
        <button class="btn" @onclick="RefreshAsync" disabled="@isBusy">
            @if (isBusy)
            {
                <span class="spinner"></span>
            }
            Refresh
        </button>
    </div>

    @if (cards.Count == 0)
    {
        <div class="card empty-state">
            <h2>Nothing to compare yet</h2>
            <p>Connect an account and tick the repositories you want to monitor — their stats land here.</p>
            <button class="btn primary" @onclick="@(() => Nav.NavigateTo("/accounts/edit"))">+ Add an account</button>
        </div>
    }
    else
    {
        <div class="card repo-table">
            @* Re-keyed whenever the monitored set changes: ServerData is only re-invoked by the
               grid itself (on a header click) or on its first render, so recreating the component
               is the only way to push an added/removed repo into it. *@
            <DataGrid TItem="RepoCardModel"
                      @key="gridEpoch"
                      ServerData="LoadAsync"
                      SortMode="DataGridSortMode.Single"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Bordered="true"
                      FixedHeader="true"
                      Height="calc(100vh - 195px)"
                      NoRecordsText="No repositories are being monitored.">
                <Columns>
                    @* Filtering is switched off on every column: with ServerData in play the grid
                       hands filters back for the app to apply, and sorting — not filtering — is
                       what this page is for. Leaving it on would render filter menus that do nothing. *@
                    <PropertyColumn Property="c => c.Title" Title="Repository" Filterable="false">
                        <CellTemplate>
                            <span class="grid-link" title="Open repository"
                                  @onclick="() => OpenAsync(context.Item.RepoUrl)">@context.Item.Title</span>
                            @if (context.Item.HasError)
                            {
                                <span title="@context.Item.ErrorMessage">
                                    <Pill Text="Error" Type="PillType.Critical" />
                                </span>
                            }
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="c => c.AccountLabel" Title="Account" Filterable="false" />

                    @* Bound to the rank rather than a bool so sorting reads as private-first
                       and repos with no snapshot yet sort last instead of with the public ones. *@
                    <PropertyColumn Property="c => c.VisibilityRank" Title="Visibility" Filterable="false">
                        <CellTemplate>
                            <VisibilityPill IsPrivate="context.Item.IsPrivate" />
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="c => c.Stars" Title="Stars" Filterable="false">
                        <CellTemplate>
                            <span class="grid-link grid-num" title="Open stargazers"
                                  @onclick="() => OpenAsync(context.Item.StarsUrl)">★ @context.Item.Stars</span>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="c => c.Forks" Title="Forks" Filterable="false">
                        <CellTemplate>
                            <span class="grid-link grid-num" title="Open forks"
                                  @onclick="() => OpenAsync(context.Item.ForksUrl)">⑂ @context.Item.Forks</span>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="c => c.Watchers" Title="Watchers" Filterable="false">
                        <CellTemplate>
                            <span class="grid-link grid-num" title="Open watchers"
                                  @onclick="() => OpenAsync(context.Item.WatchersUrl)">👁 @context.Item.Watchers</span>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="c => c.OpenIssues" Title="Open issues" Filterable="false">
                        <CellTemplate>
                            <span class="grid-link grid-num" title="Open issues"
                                  @onclick="() => OpenAsync(context.Item.IssuesUrl)">@context.Item.OpenIssues</span>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="c => c.OpenPullRequests" Title="Open PRs" Filterable="false">
                        <CellTemplate>
                            <span class="grid-link grid-num" title="Open pull requests"
                                  @onclick="() => OpenAsync(context.Item.PullsUrl)">@context.Item.OpenPullRequests</span>
                        </CellTemplate>
                    </PropertyColumn>

                    @* Bound to the numeric rank, not the status text, so sorting puts failures
                       first instead of ordering them alphabetically. *@
                    <PropertyColumn Property="c => c.BuildRank" Title="Build" Filterable="false">
                        <CellTemplate>
                            <span class="grid-link" title="@context.Item.LatestRunDescription"
                                  @onclick="() => OpenAsync(context.Item.LatestRunUrl ?? context.Item.ActionsUrl)">
                                <Pill Text="@(context.Item.LatestRunStatus ?? "No runs")"
                                      Type="context.Item.LatestRunPillType" />
                            </span>
                        </CellTemplate>
                    </PropertyColumn>
                </Columns>
            </DataGrid>
        </div>
    }
</div>

@code {
    readonly List<RepoCardModel> cards = new();
    readonly List<IDisposable> subs = new();

    bool isBusy;
    int gridEpoch;

    RepoGridSort sort = RepoGridSort.Default;

    // False until the grid has asked for data once. The first ask carries an empty sort
    // list (the grid starts unsorted), which must NOT be read as "the user cleared the
    // sort" — that would overwrite the sort we just restored from storage.
    bool gridLoaded;

    string Subtitle
    {
        get
        {
            var accounts = Config.Accounts.Count;
            var arrow = sort.Descending ? "↓" : "↑";
            return $"{cards.Count} repo{(cards.Count == 1 ? "" : "s")} across " +
                   $"{accounts} account{(accounts == 1 ? "" : "s")} · sorted by {RepoGridColumns.Label(sort.ColumnId)} {arrow}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        subs.Add(Mediator.Subscribe<SnapshotUpdatedEvent>(OnSnapshotUpdated));
        Config.Changed += OnConfigChanged;

        sort = await Config.GetRepoGridSortAsync();
        await Config.ReloadAsync();
        RebuildCards();
    }

    /// <summary>
    /// The grid's data source. It is also the only hook the grid exposes onto its sort
    /// state, so persisting here IS the "remember my sort" feature: the grid calls this
    /// on first render and again after every header click.
    /// </summary>
    async Task<GridData<RepoCardModel>> LoadAsync(GridState state)
    {
        if (gridLoaded)
        {
            // A real header click. An empty list means the column was cycled past descending
            // back to unsorted — fall back to the default rather than leaving the rows in
            // whatever arbitrary order they happened to be in.
            var def = state.SortDefinitions.FirstOrDefault();
            var next = def is null
                ? RepoGridSort.Default
                : new RepoGridSort(def.ColumnId, def.Direction == DataGridSortDirection.Descending);

            if (next != sort)
            {
                sort = next;
                await Config.SetRepoGridSortAsync(sort);
                // The grid re-renders itself after this returns, but this page does not —
                // without it the header line keeps describing the previous sort.
                StateHasChanged();
            }
        }
        gridLoaded = true;

        var ordered = sort.Order(cards);
        return new GridData<RepoCardModel>(ordered, ordered.Count);
    }

    Task OpenAsync(string url) => Browser.OpenAsync(url, BrowserLaunchMode.External);

    void RebuildCards()
    {
        var existing = cards.ToDictionary(c => c.Key);
        var before = cards.Select(c => c.Key).ToList();
        cards.Clear();

        foreach (var account in Config.Accounts)
        {
            foreach (var repo in account.Repos)
            {
                var key = $"{account.Id}|{repo.FullName}";
                if (!existing.TryGetValue(key, out var card))
                {
                    card = new RepoCardModel(account, repo);
                    var snap = Cache.TryGet(account.Id, repo);
                    if (snap is not null)
                        card.Apply(snap);
                }
                cards.Add(card);
            }
        }

        // Only a changed row set needs the grid rebuilt — value updates reach it through
        // the card instances it already holds.
        if (!before.SequenceEqual(cards.Select(c => c.Key)))
        {
            gridEpoch++;
            gridLoaded = false;
        }
    }

    void OnConfigChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(() =>
        {
            RebuildCards();
            StateHasChanged();
        });

    Task OnSnapshotUpdated(SnapshotUpdatedEvent e, IMediatorContext _, CancellationToken __)
        => InvokeAsync(() =>
        {
            var key = $"{e.AccountId}|{e.Repo.FullName}";
            var card = cards.FirstOrDefault(c => c.Key == key);
            if (card is null)
                return;
            // Cards are mutated in place, so the grid re-reads the new values off the same
            // instances it is already holding. Rows keep their position until the next header
            // click rather than jumping under the pointer mid-poll. As on the dashboard, only
            // re-render when something displayed actually moved — an idle app must not push a
            // render batch into the WebView on every poll.
            if (card.Apply(e.Snapshot))
                StateHasChanged();
        });

    async Task RefreshAsync()
    {
        if (isBusy)
            return;
        isBusy = true;
        try
        {
            await Mediator.Send(new RefreshAllCommand(true));
        }
        finally
        {
            isBusy = false;
        }
    }

    public void Dispose()
    {
        Config.Changed -= OnConfigChanged;
        foreach (var s in subs)
            s.Dispose();
    }
}
