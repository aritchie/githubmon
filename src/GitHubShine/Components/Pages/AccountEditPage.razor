@page "/accounts/edit"
@page "/accounts/edit/{AccountId}"
@inject ITokenVault Vault
@inject IConfigStore Config
@inject IGitProviderFactory Factory
@inject ISyncStore SyncStore
@inject NavigationManager Nav
@inject IToastService Toast

<div class="page narrow">
    <div class="page-header">
        <div>
            <h1>Account</h1>
            <span class="subtitle">Connect a GitHub or Gitea account by giving it a label and a personal access token.</span>
        </div>
    </div>

    <div class="card">
        <div class="section-title">Identity</div>

        <div class="field">
            <label>Label</label>
            <input type="text" @bind="label" placeholder="e.g. Personal, Work, OSS org" />
        </div>

        <div class="field">
            <label>Provider</label>
            <select @bind="providerType">
                <option value="@GitProviderType.GitHub">GitHub</option>
                <option value="@GitProviderType.Gitea">Gitea / Forgejo</option>
            </select>
        </div>

        <div class="field">
            <label>
                Host URL
                <span class="hint">@(providerType == GitProviderType.Gitea ? "— required, e.g. https://gitea.com" : "— optional; leave blank for github.com, or set a GitHub Enterprise host")</span>
            </label>
            <input type="text" @bind="hostUrl"
                   placeholder="@(providerType == GitProviderType.Gitea ? "https://gitea.com" : "https://github.example.com (optional)")" />
        </div>

        <div class="field">
            <label>
                Personal access token
                <span class="hint">@(providerType == GitProviderType.Gitea ? "— {host}/user/settings/applications" : "— github.com/settings/personal-access-tokens")</span>
            </label>
            <input type="password" @bind="token"
                   placeholder="@TokenPlaceholder" />
            @if (hasSavedToken)
            {
                <div class="hint" style="margin-top: 4px;">
                    A token is already saved for this account. Enter a new one only to replace it.
                </div>
            }
        </div>

        <div class="pills">
            <button class="btn" @onclick="ValidateAsync" disabled="@isBusy">Validate &amp; list repos</button>
            @if (isBusy)
            {
                <span class="spinner"></span>
            }
            @if (validatedUsername is not null)
            {
                <Pill Text="@($"@{validatedUsername}")" Type="PillType.Success" />
            }
        </div>
    </div>

    <div class="card">
        <div class="page-header" style="margin-bottom: 10px;">
            <div>
                <h2>Repositories to monitor</h2>
                @if (ShowRepoList)
                {
                    <span class="subtitle">@SelectionSummary</span>
                }
            </div>
            <span class="spacer"></span>
            @if (ShowRepoList)
            {
                <button class="btn" @onclick="SelectAllVisible">Select all</button>
                <button class="btn" @onclick="ClearSelection">Clear</button>
            }
        </div>

        @if (!ShowRepoList)
        {
            <div class="card subtle">
                <span class="muted">Enter a personal access token above and click Validate to load the repositories this token can access.</span>
            </div>
        }
        else
        {
            @if (!hasFetchedRepos)
            {
                <div class="hint" style="margin-bottom: 8px;">
                    @(isBusy
                        ? "Showing the currently monitored repos — loading everything the token can access…"
                        : "Showing the currently monitored repos. Click \"Validate & list repos\" to load everything the token can access.")
                </div>
            }
            <div class="repo-pick-toolbar">
                <input type="search" value="@filterText" @oninput="OnFilterChanged"
                       placeholder="Filter repos by name or description…" />
                @if (isLoadingRepos)
                {
                    <span class="spinner"></span>
                }
            </div>

            <div class="repo-pick-list">
                @if (filteredRepos.Count == 0)
                {
                    <div class="repo-pick-row"><span class="muted">No repos match the filter.</span></div>
                }
                @foreach (var repo in filteredRepos)
                {
                    <label class="repo-pick-row" @key="repo.FullName">
                        <input type="checkbox" checked="@repo.IsSelected"
                               @onchange="e => OnRepoToggled(repo, e)" />
                        <span class="name">@repo.FullName</span>
                        @if (repo.Description is not null)
                        {
                            <span class="desc">@repo.Description</span>
                        }
                        <span class="badge">
                            @if (hasFetchedRepos && !repo.IsVisibleToToken)
                            {
                                <Pill Text="Not visible to token" Type="PillType.Warning" />
                            }
                            else
                            {
                                @* Before the listing lands nothing is known about a saved repo's
                                   visibility, so pass null rather than the not-yet-populated false. *@
                                <VisibilityPill IsPrivate="@(hasFetchedRepos ? repo.Private : (bool?)null)" />
                            }
                        </span>
                    </label>
                }
            </div>
        }
    </div>

    <div class="actions-bar">
        <span class="status">
            @if (validationMessage is not null)
            {
                @validationMessage
            }
        </span>
        @if (isBusy)
        {
            <span class="spinner"></span>
        }
        <button class="btn" @onclick="@(() => Nav.NavigateTo("/accounts"))">Cancel</button>
        <button class="btn primary" @onclick="SaveAsync" disabled="@isBusy">Save account</button>
    </div>
</div>

@code {
    [Parameter] public string? AccountId { get; set; }

    string label = "";
    string token = "";
    GitProviderType providerType = GitProviderType.GitHub;
    string hostUrl = "";
    string? validationMessage;
    string? validatedUsername;
    bool isBusy;
    bool isLoadingRepos;
    bool hasFetchedRepos;
    bool hasSavedToken;
    string filterText = "";

    List<string> existingRepoFullNames = new();
    readonly List<RepoSelection> availableRepos = new();
    List<RepoSelection> filteredRepos = new();

    string TokenPlaceholder => hasSavedToken
        ? "•••••••• (token saved — leave blank to keep it)"
        : (providerType == GitProviderType.Gitea ? "your Gitea token" : "github_pat_...");

    bool ShowRepoList => hasFetchedRepos || availableRepos.Count > 0;
    int SelectedCount => availableRepos.Count(r => r.IsSelected);
    string SelectionSummary => availableRepos.Count == 0
        ? ""
        : $"{SelectedCount} selected of {availableRepos.Count} available";

    protected override async Task OnInitializedAsync()
    {
        await Config.ReloadAsync();
        var account = AccountId is null
            ? null
            : Config.Accounts.FirstOrDefault(a => a.Id == AccountId);

        if (account is not null)
        {
            label = account.Label;
            providerType = account.ProviderType;
            hostUrl = account.HostUrl ?? "";
            validatedUsername = account.Username;
            existingRepoFullNames = account.Repos.Select(r => r.FullName).ToList();
            hasSavedToken = !string.IsNullOrWhiteSpace(await Vault.GetTokenAsync(account.Id));

            // Show the currently monitored repos immediately so they can be
            // unchecked/saved without a round-trip to GitHub. A later fetch
            // rebuilds this list with full visibility info.
            foreach (var repo in account.Repos)
            {
                availableRepos.Add(new RepoSelection
                {
                    Owner = repo.Owner,
                    Name = repo.Name,
                    IsVisibleToToken = true,
                    IsSelected = true
                });
            }
            RebuildFiltered();

            // With a saved token there's nothing for the user to enter — load the
            // full repo list right away so more repos can be picked immediately.
            // Fire-and-forget: the monitored repos above render first, the full
            // list merges in when GitHub responds.
            if (hasSavedToken)
                _ = AutoLoadReposAsync();
        }
    }

    async Task AutoLoadReposAsync()
    {
        await ValidateAsync();
        StateHasChanged();
    }

    void OnFilterChanged(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? "";
        RebuildFiltered();
    }

    void RebuildFiltered()
    {
        IEnumerable<RepoSelection> source = availableRepos;
        if (!string.IsNullOrWhiteSpace(filterText))
        {
            var f = filterText.Trim();
            source = source.Where(r =>
                r.FullName.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                (r.Description?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        filteredRepos = source.ToList();
    }

    void OnRepoToggled(RepoSelection repo, ChangeEventArgs e)
        => repo.IsSelected = (bool)e.Value!;

    void SelectAllVisible()
    {
        foreach (var r in filteredRepos)
            r.IsSelected = true;
    }

    void ClearSelection()
    {
        foreach (var r in availableRepos)
            r.IsSelected = false;
    }

    async Task<string?> ResolveTokenAsync()
    {
        if (!string.IsNullOrWhiteSpace(token))
            return token;
        if (AccountId is not null)
            return await Vault.GetTokenAsync(AccountId);
        return null;
    }

    async Task ValidateAsync()
    {
        var effectiveToken = await ResolveTokenAsync();
        if (string.IsNullOrWhiteSpace(effectiveToken))
        {
            validationMessage = "Enter a token first";
            return;
        }
        if (providerType == GitProviderType.Gitea && string.IsNullOrWhiteSpace(hostUrl))
        {
            validationMessage = "A host URL is required for Gitea";
            return;
        }
        isBusy = true;
        try
        {
            var provider = Factory.Create(providerType, EffectiveHost, effectiveToken, AccountId ?? "validate");
            var user = await provider.ValidateAndGetUserAsync();
            validatedUsername = user.Login;
            validationMessage = $"Authenticated as @{user.Login}";

            await FetchReposAsync(provider);
        }
        catch (Exception ex)
        {
            validatedUsername = null;
            validationMessage = $"Failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    string? EffectiveHost => string.IsNullOrWhiteSpace(hostUrl) ? null : hostUrl.Trim();

    async Task FetchReposAsync(IGitProvider provider)
    {
        isLoadingRepos = true;
        try
        {
            // Carry forward the user's current (possibly unsaved) selections,
            // then rebuild from the API response.
            var selected = new HashSet<string>(
                availableRepos.Where(r => r.IsSelected).Select(r => r.FullName),
                StringComparer.OrdinalIgnoreCase);
            if (availableRepos.Count == 0)
                foreach (var fn in existingRepoFullNames)
                    selected.Add(fn);

            availableRepos.Clear();

            var fetched = await provider.ListAccessibleReposAsync();

            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var r in fetched.OrderBy(x => x.FullName, StringComparer.OrdinalIgnoreCase))
            {
                availableRepos.Add(new RepoSelection
                {
                    Owner = r.Owner,
                    Name = r.Name,
                    Description = r.Description,
                    Private = r.Private,
                    IsVisibleToToken = true,
                    IsSelected = selected.Contains(r.FullName)
                });
                seen.Add(r.FullName);
            }

            // Preserve selected repos the token can't see — keep them checked so
            // Save doesn't silently drop them.
            foreach (var fn in selected.Where(n => !seen.Contains(n)))
            {
                var parts = fn.Split('/', 2);
                if (parts.Length != 2)
                    continue;
                availableRepos.Add(new RepoSelection
                {
                    Owner = parts[0],
                    Name = parts[1],
                    IsVisibleToToken = false,
                    IsSelected = true
                });
            }

            hasFetchedRepos = true;
            RebuildFiltered();
        }
        catch (Exception ex)
        {
            validationMessage = $"Authenticated, but couldn't list repos: {ex.Message}";
        }
        finally
        {
            isLoadingRepos = false;
        }
    }

    async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            validationMessage = "Label required";
            return;
        }
        if (providerType == GitProviderType.Gitea && string.IsNullOrWhiteSpace(hostUrl))
        {
            validationMessage = "A host URL is required for Gitea";
            return;
        }
        isBusy = true;
        try
        {
            var id = AccountId ?? Guid.NewGuid().ToString("n");
            var repos = availableRepos
                .Where(r => r.IsSelected)
                .Select(r => new MonitoredRepo(r.Owner, r.Name))
                .ToList();
            var account = new MonitoredAccount(id, label.Trim(), validatedUsername, repos, providerType, EffectiveHost);
            await Config.UpsertAccountAsync(account);
            if (!string.IsNullOrWhiteSpace(token))
                await Vault.SetTokenAsync(id, token);
            // Drop any cached provider so provider-type / host / token edits take effect.
            Factory.Invalidate(id);

            // Unticking a repo here also retires its syncs — a mapping reading a repo the account
            // no longer monitors can only fail when it runs.
            var pruned = await SyncStore.PruneForAccountAsync(id, repos);

            var syncNote = pruned.Count == 0
                ? ""
                : $", removed {pruned.Count} sync{(pruned.Count == 1 ? "" : "s")}";
            await Toast.SuccessAsync($"Saved {label.Trim()} — {repos.Count} repo(s){syncNote}");
            Nav.NavigateTo("/accounts");
        }
        catch (Exception ex)
        {
            validationMessage = $"Save failed: {ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
