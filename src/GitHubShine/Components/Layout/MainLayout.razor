@inherits LayoutComponentBase
@implements IDisposable
@inject AppPlatformInfo Platform
@inject NavigationManager Nav

<main class="@(Platform.IsMobile ? "has-tabbar" : null)">
    @* Nav lives in Items (not EndContent) so ShinyToolbar's auto-overflow kicks in:
       when the links don't fit the bar's width they collapse behind a "More" menu.
       The overflow logic is disabled whenever EndContent is set, so the brand goes
       in StartContent and the links go through Items.

       On mobile there is nothing to overflow into: even with Archive and Sync hidden,
       a phone-width bar can only seat one or two labelled items next to the brand, so
       nearly the whole nav ends up behind "More" — two taps to reach any screen. There
       the links move to a bottom tab bar instead (see below) and Items is left empty,
       leaving the top bar as a plain title bar. *@
    <ShinyToolbar Frosted="true"
                  BlurRadius="18"
                  TintColor="var(--toolbar-tint)"
                  TextColor="var(--fg)"
                  HasShadow="true"
                  SafeArea="true"
                  Sticky="true"
                  ShowItemLabels="true"
                  Items="toolbarItems"
                  OverflowText="More"
                  OverflowAriaLabel="More navigation"
                  MenuBackgroundColor="var(--card)"
                  MenuTextColor="var(--fg)">
        <StartContent>
            <span class="toolbar-brand">
                <img class="toolbar-logo" src="img/logo.svg" alt="" />
                <span class="toolbar-title">GitHub Shine</span>
            </span>
        </StartContent>
    </ShinyToolbar>

    @Body
</main>

@if (Platform.IsMobile)
{
    @* Thumb-reachable bottom tabs, the platform-native pattern on iOS and Android.
       aria-current marks the active tab for screen readers; the visual state is the
       .active class (both driven by the same NavEntry.Active flag as the toolbar). *@
    <nav class="tabbar" aria-label="Main">
        @foreach (var entry in navEntries)
        {
            <a class="tabbar-item @(entry.Active ? "active" : null)"
               href="@entry.Href"
               aria-current="@(entry.Active ? "page" : null)">
                <span class="tabbar-icon">@((MarkupString)entry.Icon)</span>
                <span class="tabbar-label">@entry.ShortText</span>
            </a>
        }
    </nav>
}

<ToastHost />

@code {
    // Octicon-style line icons (24x24, stroke=currentColor) so they pick up the
    // toolbar foreground — and the active item's IconColor — automatically.
    const string DashboardIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 11l9-8 9 8'/><path d='M5 10v10h14V10'/></svg>";
    const string AccountsIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8' r='3.2'/><path d='M3.5 20c0-3 2.7-5 5.5-5s5.5 2 5.5 5'/><path d='M16 5.5a3.2 3.2 0 0 1 0 6'/><path d='M21 20c0-2.4-1.4-4-3.4-4.6'/></svg>";
    const string PersonsIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='8' r='3.4'/><path d='M5.5 20c0-3.3 2.9-5.6 6.5-5.6s6.5 2.3 6.5 5.6'/><path d='M12 2.2v1.2'/><path d='M12 12.6v1.2'/></svg>";
    const string ArchiveIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='4' rx='1'/><path d='M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8'/><path d='M10 12h4'/></svg>";
    const string CloneIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='9' y='9' width='12' height='12' rx='2'/><path d='M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1'/></svg>";
    const string SyncIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 10a8 8 0 0 1 13.7-5.7L20 6'/><path d='M20 3v4h-4'/><path d='M20 14a8 8 0 0 1-13.7 5.7L4 18'/><path d='M4 21v-4h4'/></svg>";
    const string SettingsIcon = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='3'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.09a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z'/></svg>";

    // One nav model feeds both presentations: ToolbarItems on desktop, the bottom tab bar
    // on mobile. ShortText is what the tab bar shows — a tab is roughly a quarter of a
    // phone's width, and "Repositories" simply doesn't fit at a legible size.
    sealed record NavEntry(string Icon, string Text, string ShortText, string Href, bool Active);

    List<NavEntry> navEntries = new();
    List<ToolbarItem> toolbarItems = new();

    protected override void OnInitialized()
    {
        BuildNav();
        Nav.LocationChanged += OnLocationChanged;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        BuildNav();
        StateHasChanged();
    }

    // Rebuilt on every navigation so the active link can be tinted. ToolbarItem
    // exposes no per-item "active" hook, so IconColor doubles as the highlight
    // (it sets the item's CSS color, which the icon + label both inherit).
    void BuildNav()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');

        // Repositories merged into the dashboard — the grid is a view you switch to there, not a
        // screen of its own — so /repos stays live as a deep link but has no entry of its own, and
        // the dashboard is the active item when you land on it.
        var entries = new List<NavEntry>
        {
            new(DashboardIcon, "Dashboard", "Home", "/", rel.Length == 0 || IsSection(rel, "repos")),
            new(PersonsIcon, "People", "People", "/persons", IsSection(rel, "persons")),
            new(AccountsIcon, "Accounts", "Accounts", "/accounts", IsSection(rel, "accounts")),
        };

        // Archive isn't usable on phones, and Sync is a desktop workflow (two accounts, a mapping
        // list) that a phone-width page can't lay out — so those two stay off the tab bar. Clone
        // does ship there: on mobile it needs no folder picker (see ClonePage) and clones into the
        // app's own storage. Six tabs is the most a phone bar can seat legibly; anything more and
        // the labels start to collide, so a seventh needs one of these to move rather than be added.
        if (!Platform.IsMobile)
            entries.Add(new(ArchiveIcon, "Archive", "Archive", "/archive", IsSection(rel, "archive")));

        // Clone sits next to Archive on desktop: both take monitored repos and put them in a folder,
        // one as a zip snapshot, the other as a live working copy you can keep catching up.
        entries.Add(new(CloneIcon, "Clone", "Clone", "/clone", IsSection(rel, "clone")));

        if (!Platform.IsMobile)
            entries.Add(new(SyncIcon, "Sync", "Sync", "/sync", IsSection(rel, "sync")));

        entries.Add(new(SettingsIcon, "Settings", "Settings", "/settings", IsSection(rel, "settings")));

        navEntries = entries;

        // Mobile navigates from the tab bar, so the toolbar gets no items at all — an
        // empty Items list keeps its overflow measuring from ever producing a "More".
        toolbarItems = Platform.IsMobile
            ? new List<ToolbarItem>()
            : entries.Select(ToToolbarItem).ToList();
    }

    static bool IsSection(string rel, string segment)
        => rel == segment || rel.StartsWith(segment + "/", StringComparison.Ordinal);

    static ToolbarItem ToToolbarItem(NavEntry e) => new()
    {
        Icon = e.Icon,
        Text = e.Text,
        Href = e.Href,
        IconColor = e.Active ? "var(--link)" : null
    };

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
