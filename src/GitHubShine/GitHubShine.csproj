<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-macos;net10.0-ios;net10.0-android</TargetFrameworks>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0</TargetFramework>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>GitHubShine</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>GitHub Shine</ApplicationTitle>
		<ApplicationId>net.shiny.githubshine</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<_IsMobile Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</_IsMobile>
		<_IsLinux Condition="$(TargetFramework) == 'net10.0' AND $([MSBuild]::IsOSPlatform('linux'))">true</_IsLinux>
	</PropertyGroup>

	<PropertyGroup Condition="'$(_IsMobile)' == 'true'">
		<DefineConstants>$(DefineConstants);MOBILE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\Tray\**" />
		<EmbeddedResource Include="Resources\Tray\trayicon.png" />
		<EmbeddedResource Include="Resources\Tray\trayicon@2x.png" />
		<EmbeddedResource Include="Resources\Tray\trayicon@3x.png" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#24292F" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Platforms\**\*.cs" />
		<Compile Remove="Platforms\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
		<Compile Include="Platforms\MacOS\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(_IsLinux)' == 'true'">
		<Compile Include="Platforms\Linux\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('windows'))">
		<Compile Include="Platforms\Windows\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<Compile Include="Platforms\Android\**\*.cs" />

		<!-- libgit2, built by eng/libgit2/build-android.sh. LibGit2Sharp.NativeBinaries has no
		     Android RID, so without these the managed assembly loads and then throws
		     DllNotFoundException on first use (which GitRuntime reports as "Git support isn't
		     available"). The file name is the DllImport name and is tied to the pinned
		     LibGit2Sharp version — see eng/libgit2/README.md. -->
		<AndroidNativeLibrary Include="Platforms\Android\native\arm64-v8a\libgit2-5853918.so" Abi="arm64-v8a" />
		<AndroidNativeLibrary Include="Platforms\Android\native\x86_64\libgit2-5853918.so" Abi="x86_64" />

		<!-- ...and keep the package's own natives out of the APK. The RID graph falls android-arm64
		     -> linux-arm64, so LibGit2Sharp.NativeBinaries' *glibc* build gets packaged under the
		     same file name as ours and wins. It then fails to dlopen on device looking for
		     libc.so.6, which bionic does not have and never will. -->
		<PackageReference Include="LibGit2Sharp.NativeBinaries" ExcludeAssets="all" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<Compile Include="Platforms\iOS\**\*.cs" />

		<!-- libgit2, built by eng/libgit2/build-ios.sh — see eng/libgit2/README.md. Device and
		     simulator slices are separate files because they can't be lipo'd together (both arm64,
		     different platform), so the right one is picked by RID. As on Android, the package's
		     own natives are excluded so its macOS build can't be substituted for ours. -->
		<PackageReference Include="LibGit2Sharp.NativeBinaries" ExcludeAssets="all" />
	</ItemGroup>

	<!-- Copied into the bundle rather than referenced with @(NativeReference Kind="Dynamic"),
	     which does not work on iOS: that links the dylib into the app binary and rewrites its path
	     to "@executable_path/Contents/MonoBundle/…" — the *macOS* bundle layout, hardcoded as
	     _CustomBundleName in Xamarin.Shared.targets — while placing the file at the root of the
	     flat iOS bundle. dyld then can't find it and the app dies before Main.

	     As a bundle resource there is no load command at all: the file sits next to the managed
	     assemblies and LibGit2Sharp's DllImport resolves it lazily out of the assembly directory,
	     exactly as it does from the runtimes folder on desktop. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And $(RuntimeIdentifier.StartsWith('iossimulator'))">
		<BundleResource Include="Platforms\iOS\native\simulator\git2-5853918.dylib" LogicalName="git2-5853918.dylib" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !$(RuntimeIdentifier.StartsWith('iossimulator'))">
		<BundleResource Include="Platforms\iOS\native\device\git2-5853918.dylib" LogicalName="git2-5853918.dylib" />
	</ItemGroup>

	<!-- ...which does mean nothing else signs it. A dylib inside the bundle is code, and on a
	     device dyld refuses to load an unsigned one, so it gets signed with the app's own identity
	     just before the bundle itself is sealed. The simulator doesn't enforce this. -->
	<Target Name="_SignLibGit2Native"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !$(RuntimeIdentifier.StartsWith('iossimulator')) And '$(_CodeSigningKey)' != ''"
	        BeforeTargets="_CodesignAppBundle">
		<Exec Command="codesign --force --sign &quot;$(_CodeSigningKey)&quot; &quot;$(AppBundleDir)/git2-5853918.dylib&quot;" />
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />
		<PackageReference Include="Shiny.Mediator.Maui" />
		<PackageReference Include="Shiny.Notifications" />
		<!-- Background scheduling. On iOS/Android this binds the native schedulers
		     (BGTaskScheduler / WorkManager); the desktop heads have no net10.0-macos or
		     net10.0-windows asset and fall back to lib/net10.0, which is Shiny's in-process
		     timer-driven JobManager — the same thing the hand-rolled loops used to be. -->
		<PackageReference Include="Shiny.Jobs" />
		<PackageReference Include="Shiny.Blazor.Controls" />
		<PackageReference Include="Shiny.DocumentDb.Sqlite" />
		<PackageReference Include="Shiny.Extensions.Stores" />
		<PackageReference Include="Shiny.Extensions.DependencyInjection" />

		<PackageReference Include="Octokit" />
		<PackageReference Include="LibGit2Sharp" />
	</ItemGroup>

	<ItemGroup Condition="'$(_IsMobile)' != 'true'">
		<PackageReference Include="Shiny.Maui.Controls.Desktop"/>
	</ItemGroup>

	<!-- Shiny's MAUI host (UseShiny). Only referenced on the heads it actually supports — its
	     net10.0 asset is empty, so the labs macOS/Linux heads call AddShinyCoreServices instead. -->
	<ItemGroup Condition="'$(_IsMobile)' == 'true' Or $(TargetFramework.Contains('windows'))">
		<PackageReference Include="Shiny.Hosting.Maui" />
	</ItemGroup>

	<!-- MAUI DevFlow: the CLI's in-app agent, plus the Blazor tools that expose the WebView over
	     CDP (this app's UI is entirely Blazor, so without the second package the tree stops at the
	     WebView).
	     The base packages ship android/ios/maccatalyst/macos/windows assets — including
	     net10.0-macos, so the labs AppKit head is covered — while the GTK4 Linux head (plain
	     net10.0) needs the .Gtk pair instead.

	     DEBUG-ONLY. Every call site is inside #if DEBUG (MauiProgram registration and, for the
	     GTK head, App.OnStart), so in Release the assemblies were pure dead weight shipped to
	     users — and the agent opens a local HTTP server, which is not something a distributed
	     build should carry at all. $(Configuration) == 'Debug' is the same switch the SDK uses
	     to define the DEBUG symbol, so the references track the #if exactly; if a custom
	     configuration ever defines DEBUG, update this condition to match.

	     Cost of the split: obj/project.assets.json is per-project, not per-configuration, so
	     alternating `build -c Debug` and `build -c Release` re-restores each time. That is a few
	     seconds from the local NuGet cache, and CI only ever builds Release. -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug' AND '$(_IsLinux)' != 'true'">
		<PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
		<PackageReference Include="Microsoft.Maui.DevFlow.Blazor" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' AND '$(_IsLinux)' == 'true'">
		<PackageReference Include="Microsoft.Maui.DevFlow.Agent.Gtk" />
		<PackageReference Include="Microsoft.Maui.DevFlow.Blazor.Gtk" />
	</ItemGroup>
	
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
		<PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
		<PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
		<PackageReference Include="Microsoft.Maui.Platforms.MacOS.BlazorWebView" />
	</ItemGroup>

	<ItemGroup Condition="'$(_IsLinux)' == 'true'">
		<PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" />
		<PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
		<PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.BlazorWebView" />
		<PackageReference Include="Shiny.Notifications.Linux" />
		<!-- IBattery/IConnectivity for the job manager: Shiny.Core's plain net10.0 asset ships
		     only the interfaces, so the GTK head needs the Linux implementations. -->
		<PackageReference Include="Shiny.Core.Linux" />
	</ItemGroup>

	<PropertyGroup Condition="'$(_IsLinux)' == 'true'">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>

	<!--
	  MAUI SingleProject stamps ExcludeFromCurrentConfiguration=true on every Compile item under
	  Platforms\** and only re-enables the folders it recognises (Android/iOS/MacCatalyst/Windows/
	  Tizen). It doesn't know the maui-labs desktop backends (net-macos lives in Platforms\MacOS,
	  GTK4 Linux in Platforms\Linux), so _MauiRemovePlatformCompileItems would strip our entry-point
	  Program.cs and platform code — leaving CS5001 (no Main) + missing GitHubShine.Platforms.*.
	  Re-enable the current desktop backend's folder just before MAUI does its removal pass.
	-->
	<Target Name="_GitHubShineKeepDesktopPlatformCompile"
	        BeforeTargets="_MauiRemovePlatformCompileItems">
		<ItemGroup>
			<Compile Update="Platforms\MacOS\**\*$(DefaultLanguageSourceExtension)"
			         Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
				<ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
			</Compile>
			<Compile Update="Platforms\Linux\**\*$(DefaultLanguageSourceExtension)"
			         Condition="'$(_IsLinux)' == 'true'">
				<ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
			</Compile>
		</ItemGroup>
	</Target>
</Project>
