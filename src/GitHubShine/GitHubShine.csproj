<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-macos</TargetFramework>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0</TargetFramework>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>GitHubShine</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>GitHub Shine</ApplicationTitle>
		<ApplicationId>net.shiny.githubshine</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- Stock MAUI SingleProject only auto-routes Platforms/<X> for iOS, MacCatalyst,
		     Android, Windows, Tizen. It doesn't know about the maui-labs `macos` and `linux`
		     identifiers, so we exclude those folders from default globbing and re-include
		     them per TFM below. -->
<!--<DefaultItemExcludes>$(DefaultItemExcludes);Platforms\MacOS\**;Platforms\Linux\**</DefaultItemExcludes>-->

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Tray icon: template-style monochrome PNGs loaded by TrayIconHost via
		     Assembly.GetManifestResourceStream("...trayicon.png"). -->
		<None Remove="Resources\Tray\**" />
		<EmbeddedResource Include="Resources\Tray\trayicon.png" />
		<EmbeddedResource Include="Resources\Tray\trayicon@2x.png" />
		<EmbeddedResource Include="Resources\Tray\trayicon@3x.png" />
	</ItemGroup>

	<ItemGroup>
		<!-- appicon.svg is fully composed (background + artwork + macOS margins);
		     no ForegroundFile, since the labs macOS icon task only renders the base. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#24292F" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Platforms\**\*.cs" />
		<Compile Remove="Platforms\**\*.cs" />
	</ItemGroup>
	<!-- Stock MAUI SingleProject only auto-routes iOS, MacCatalyst, Android, Windows, Tizen.
	     It also runs `<Compile Remove="Platforms\**" />` as part of its targets to strip every
	     other Platforms/<X> folder, so a plain top-level ItemGroup Include gets removed.
	     We re-add the labs platform files in a target that runs before CoreCompile. -->
	<Target Name="_GitHubShineReincludePlatformFiles" BeforeTargets="CoreCompile">
		<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
			<Compile Include="Platforms\MacOS\**\*.cs" />
		</ItemGroup>
		<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' AND $([MSBuild]::IsOSPlatform('linux'))">
			<Compile Include="Platforms\Linux\**\*.cs" />
		</ItemGroup>
		<ItemGroup Condition="$(TargetFramework.Contains('windows'))">
			<Compile Include="Platforms\Windows\**\*.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />

		<PackageReference Include="Shiny.Mediator.Maui" />
		<PackageReference Include="Shiny.Notifications" />
		<PackageReference Include="Shiny.Blazor.Controls" />
		<PackageReference Include="Shiny.Maui.Controls.Desktop" />
		<PackageReference Include="Shiny.DocumentDb.Sqlite" />
		<PackageReference Include="Shiny.DocumentDb.Extensions.DependencyInjection" />
		<PackageReference Include="Shiny.Extensions.Stores" />
		<PackageReference Include="Shiny.Extensions.DependencyInjection" />

		<PackageReference Include="Octokit" />
	</ItemGroup>

	<!-- Native macOS (AppKit) via maui-labs: Platform.Maui.MacOS 0.3.x (renamed from
	     Microsoft.Maui.Platforms.MacOS). BlazorWebView ships as its own package with a
	     macOS-specific control (MacOSBlazorWebView). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
		<PackageReference Include="Platform.Maui.MacOS" />
		<PackageReference Include="Platform.Maui.MacOS.Essentials" />
		<PackageReference Include="Platform.Maui.MacOS.BlazorWebView" />
	</ItemGroup>

	<!-- Linux (GTK4) via maui-labs.
	     Linux uses the bare net10.0 TFM (no -linux identifier), and that TFM is also built as
	     a fallback DLL on macOS/Windows, so gate both the packages AND the LINUX define on
	     IsOSPlatform('linux') to avoid pulling GTK refs into the non-runtime fallback. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' AND $([MSBuild]::IsOSPlatform('linux'))">
		<PackageReference Include="Platform.Maui.Linux.Gtk4" />
		<PackageReference Include="Platform.Maui.Linux.Gtk4.Essentials" />
		<PackageReference Include="Platform.Maui.Linux.Gtk4.BlazorWebView" />
		<PackageReference Include="Shiny.Notifications.Linux" />
	</ItemGroup>
	
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' AND $([MSBuild]::IsOSPlatform('linux'))">
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>

</Project>
